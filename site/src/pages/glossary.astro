---
// A dedicated glossary page — the lower-risk version of PLAN.md's planned
// (but never shipped) "site-wide glossary hover tooltips": one canonical,
// linkable reference instead of auto-scanning/rewriting already-tested
// prose across every module page. Aimed squarely at "anyone without GenAI
// experience" — every term gets a one-sentence plain-English definition and
// a link to the module that teaches it in depth.
import SiteLayout from "../layouts/SiteLayout.astro";
import { GLOSSARY } from "../data/glossary";
import { MODULES } from "../data/modules";

const base = import.meta.env.BASE_URL;
const moduleTitleById = new Map(MODULES.map((m) => [m.id, m.title]));

const sorted = [...GLOSSARY].sort((a, b) => a.term.localeCompare(b.term));

/**
 * Concept-cluster view (redesign phase 4, issue #150): every GLOSSARY term
 * already carries an optional `moduleId` (55/55 current terms have one) —
 * grouping by that field, in module order, is the "connected reference
 * system" the brief asks for with zero schema change. Terms with no
 * moduleId (none currently, but the field is optional) fall into an
 * "Unsorted" bucket rather than being silently dropped.
 */
const orderedModules = [...MODULES].sort((a, b) => a.order - b.order);
const clusters = orderedModules
  .map((m) => ({
    moduleId: m.id,
    title: m.title,
    terms: GLOSSARY.filter((t) => t.moduleId === m.id).sort((a, b) => a.term.localeCompare(b.term)),
  }))
  .filter((c) => c.terms.length > 0);
const unsortedTerms = GLOSSARY.filter((t) => !t.moduleId).sort((a, b) => a.term.localeCompare(b.term));
---

<SiteLayout
  title="Glossary"
  description="Plain-English definitions for every GenAI term this curriculum uses — no prior experience assumed."
>
  <article>
    <header class="gl-hero">
      <div class="hero-meta">
        <span class="chip mono">[ {sorted.length} TERMS ]</span>
      </div>
      <h1>The vocabulary, in plain English.</h1>
      <p class="intro">
        Every jargon word this curriculum uses, defined in one sentence, no prior GenAI experience assumed. Each term
        links to the module that teaches it in depth — start here if a word stopped you cold anywhere on this site.
      </p>
      <div class="gl-search-wrap">
        <input
          type="text"
          id="gl-search"
          class="gl-search"
          placeholder="Filter terms..."
          aria-label="Filter glossary terms"
          autocomplete="off"
        />
      </div>

      <div class="gl-view-toggle" role="group" aria-label="Glossary view">
        <button type="button" class="chip gl-view-btn" data-gl-view-btn="alpha" aria-pressed="true">Alphabetical</button>
        <button type="button" class="chip gl-view-btn" data-gl-view-btn="cluster" aria-pressed="false">By concept cluster</button>
      </div>
    </header>

    <dl class="gl-list" id="gl-list" data-gl-view-panel="alpha">
      {
        sorted.map((entry) => (
          <div class="gl-entry" data-gl-entry data-gl-term={entry.term.toLowerCase()}>
            <dt class="gl-term">{entry.term}</dt>
            <dd class="gl-def">
              {entry.definition}
              {entry.moduleId && moduleTitleById.has(entry.moduleId) && (
                <a class="gl-module-link" href={`${base}modules/${entry.moduleId}/`}>
                  See Module: {moduleTitleById.get(entry.moduleId)} →
                </a>
              )}
            </dd>
          </div>
        ))
      }
    </dl>

    <div class="gl-list gl-list--cluster" id="gl-list-cluster" data-gl-view-panel="cluster" hidden>
      {
        clusters.map((cluster) => (
          <section class="gl-cluster" aria-labelledby={`gl-cluster-${cluster.moduleId}`}>
            <h2 id={`gl-cluster-${cluster.moduleId}`} class="gl-cluster-title">
              <a href={`${base}modules/${cluster.moduleId}/`}>{cluster.title}</a>
            </h2>
            <dl class="gl-cluster-terms">
              {cluster.terms.map((entry) => (
                <div class="gl-entry" data-gl-entry data-gl-term={entry.term.toLowerCase()}>
                  <dt class="gl-term">{entry.term}</dt>
                  <dd class="gl-def">{entry.definition}</dd>
                </div>
              ))}
            </dl>
          </section>
        ))
      }
      {
        unsortedTerms.length > 0 && (
          <section class="gl-cluster" aria-labelledby="gl-cluster-unsorted">
            <h2 id="gl-cluster-unsorted" class="gl-cluster-title">Unsorted</h2>
            <dl class="gl-cluster-terms">
              {unsortedTerms.map((entry) => (
                <div class="gl-entry" data-gl-entry data-gl-term={entry.term.toLowerCase()}>
                  <dt class="gl-term">{entry.term}</dt>
                  <dd class="gl-def">{entry.definition}</dd>
                </div>
              ))}
            </dl>
          </section>
        )
      }
    </div>

    <p class="gl-empty" id="gl-empty" hidden>No terms match that filter.</p>
  </article>
</SiteLayout>

<script>
  function setup() {
    const input = document.getElementById("gl-search") as HTMLInputElement | null;
    const empty = document.getElementById("gl-empty");
    const panels = Array.from(document.querySelectorAll<HTMLElement>("[data-gl-view-panel]"));
    if (!input || !empty || !panels.length || input.dataset.bound === "true") return;
    input.dataset.bound = "true";

    // Both views render their own copy of every entry — filtering queries
    // across all of them so the currently-hidden view stays in sync and is
    // already filtered correctly whenever the visitor switches to it.
    const entries = Array.from(document.querySelectorAll<HTMLElement>("[data-gl-entry]"));
    const clusters = Array.from(document.querySelectorAll<HTMLElement>(".gl-cluster"));

    function activePanel() {
      return panels.find((p) => !p.hidden) ?? panels[0];
    }

    input.addEventListener("input", () => {
      const q = input.value.trim().toLowerCase();
      entries.forEach((el) => {
        const matches = !q || el.dataset.glTerm?.includes(q) || el.textContent?.toLowerCase().includes(q);
        el.hidden = !matches;
      });
      // A cluster whose every term got filtered out would otherwise still
      // show its (now-empty) heading — hide the whole section instead.
      clusters.forEach((cluster) => {
        const hasVisible = Array.from(cluster.querySelectorAll<HTMLElement>("[data-gl-entry]")).some((el) => !el.hidden);
        cluster.hidden = !hasVisible;
      });
      const visibleInActive = Array.from(activePanel().querySelectorAll<HTMLElement>("[data-gl-entry]")).some(
        (el) => !el.hidden,
      );
      empty.hidden = visibleInActive;
    });
  }

  function setupViewToggle() {
    const buttons = Array.from(document.querySelectorAll<HTMLButtonElement>("[data-gl-view-btn]"));
    const panels = Array.from(document.querySelectorAll<HTMLElement>("[data-gl-view-panel]"));
    if (!buttons.length || !panels.length || buttons[0].dataset.bound === "true") return;
    buttons.forEach((b) => (b.dataset.bound = "true"));

    buttons.forEach((btn) => {
      btn.addEventListener("click", () => {
        const view = btn.dataset.glViewBtn;
        buttons.forEach((b) => b.setAttribute("aria-pressed", String(b === btn)));
        panels.forEach((p) => {
          p.hidden = p.dataset.glViewPanel !== view;
        });
      });
    });
  }

  setup();
  setupViewToggle();
  document.addEventListener("astro:page-load", () => {
    setup();
    setupViewToggle();
  });
</script>

<style>
  .gl-hero {
    padding-bottom: 1.5rem;
    margin-bottom: 2rem;
    border-bottom: 2px solid var(--border);
  }

  .hero-meta {
    margin-bottom: 0.85rem;
  }

  h1 {
    margin: 0 0 0.85rem;
    font-size: clamp(1.9rem, 4vw, 2.6rem);
    font-weight: 700;
    letter-spacing: -0.02em;
  }

  .intro {
    max-width: 44rem;
    margin: 0 0 1.25rem;
    color: var(--text-secondary);
    line-height: 1.6;
    font-size: 1.05rem;
  }

  .gl-search-wrap {
    max-width: 24rem;
    margin-bottom: 1rem;
  }

  .gl-view-toggle {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .gl-view-btn {
    cursor: pointer;
    font: inherit;
    font-family: var(--font-mono);
  }

  .gl-view-btn[aria-pressed="true"] {
    border-color: var(--accent);
    color: var(--accent-text, var(--accent));
    background: color-mix(in srgb, var(--accent) 10%, var(--bg-card));
  }

  .gl-cluster {
    margin-bottom: 2rem;
  }

  .gl-cluster-title {
    margin: 0 0 0.5rem;
    font-size: 1.1rem;
  }

  .gl-cluster-title a {
    color: var(--text);
    text-decoration: none;
  }

  .gl-cluster-title a:hover {
    color: var(--accent-text, var(--accent));
    text-decoration: underline;
  }

  .gl-cluster-terms {
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  .gl-search {
    width: 100%;
    padding: 0.6rem 0.85rem;
    border: 2px solid var(--border);
    border-radius: var(--radius);
    background: var(--bg-card);
    color: var(--text);
    font-size: 0.9rem;
    font-family: inherit;
  }

  .gl-search::placeholder {
    color: var(--text-secondary);
  }

  .gl-search:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 1px;
  }

  .gl-list {
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  .gl-entry {
    padding: 1.1rem 0;
    border-bottom: 2px solid var(--border);
  }

  .gl-entry:first-child {
    padding-top: 0;
  }

  .gl-term {
    margin: 0 0 0.35rem;
    font-weight: 700;
    font-size: 1.02rem;
  }

  .gl-def {
    margin: 0;
    color: var(--text-secondary);
    line-height: 1.55;
    font-size: 0.92rem;
  }

  .gl-module-link {
    display: inline-block;
    margin-left: 0.35rem;
    white-space: nowrap;
    color: var(--accent-text, var(--accent));
    text-decoration: none;
    font-size: 0.85rem;
  }

  .gl-module-link:hover {
    text-decoration: underline;
  }

  .gl-empty {
    color: var(--text-secondary);
    font-size: 0.9rem;
    padding: 1.5rem 0;
  }
</style>
