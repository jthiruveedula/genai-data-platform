---
import SiteLayout from "../../layouts/SiteLayout.astro";
import { MODULES } from "../../data/modules";
import { PATHS, type PathInfo } from "../../data/paths";

export function getStaticPaths() {
  return PATHS.map((p) => ({
    params: { path: p.id },
    props: { path: p },
  }));
}

interface Props {
  path: PathInfo;
}

const { path } = Astro.props as Props;
const base = import.meta.env.BASE_URL;

const modules = MODULES.filter((m) => m.path === path.id).sort((a, b) => a.order - b.order);
const moduleIds = modules.map((m) => m.id);
---

<SiteLayout title={`${path.label} path`} description={`${path.description} Ends with ${path.outcome}.`}>
  <article class="path-page">
    <header class="path-hero">
      <div class="path-hero-chips">
        <span class="chip chip--accent">{path.laneLabel}</span>
        <span class="chip mono">{path.weeks}</span>
      </div>
      <h1 class="path-title">{path.label} path</h1>
      <p class="path-outcome">Ends with {path.outcome}.</p>
      <p class="path-description">{path.description}</p>

      <ul class="path-capabilities" aria-label="What you'll be able to do">
        {path.capabilities.map((c) => <li class="chip path-capability-chip">{c}</li>)}
      </ul>

      <p class="chip mono path-summary" data-path-summary aria-live="polite">
        0 of {modules.length} modules complete
      </p>
    </header>

    <!-- Milestone strip (redesign phase 2, issue #148): a compact preview of
         the rail below, built entirely from data the rail already has (no
         new fields) — clicking a milestone scrolls to and pulses the
         matching rail item, giving the (already good) rail a table-of-
         contents companion it didn't have before. -->
    <nav class="milestone-strip" aria-label="Path milestones" data-milestone-strip>
      {
        modules.map((m, i) => (
          <button type="button" class="milestone-chip" data-milestone-for={m.id}>
            <span class="milestone-order mono">{String(i + 1).padStart(2, "0")}</span>
            <span class="milestone-title">{m.title}</span>
          </button>
        ))
      }
    </nav>

    <ol class="module-rail" aria-label={`${path.label} path modules`} data-module-rail>
      {
        modules.map((m) => (
          <li class="rail-item" data-rail-item data-module-id={m.id}>
            <a class="rail-card glass-panel" href={`${base}modules/${m.id}/`}>
              <span class="rail-order mono" aria-hidden="true">
                {String(m.order).padStart(2, "0")}
              </span>
              <span class="rail-body">
                <span class="rail-title">{m.title}</span>
                <span class="rail-summary">{m.summary}</span>
              </span>
              <span class="rail-status">
                <span class="chip rail-status-chip" data-rail-status>
                  TODO
                </span>
              </span>
            </a>
          </li>
        ))
      }
    </ol>
  </article>
</SiteLayout>

<script>
  import { MODULES } from "../../data/modules";
  import { isModuleComplete, nextIncompleteModule, getCompletionSummary } from "../../lib/progress";

  function render() {
    const rail = document.querySelector<HTMLElement>("[data-module-rail]");
    if (!rail) return;

    const items = Array.from(rail.querySelectorAll<HTMLElement>("[data-rail-item]"));
    const moduleIds = items.map((el) => el.dataset.moduleId!);

    // nextIncompleteModule expects curriculum order, not just this path's
    // order, so a path page's "resume" target still lines up with the
    // site-wide notion of "what's next" — but since this rail only lists
    // this path's modules, restrict to those ids for the first-incomplete
    // marker within the path.
    const next = nextIncompleteModule(moduleIds);

    items.forEach((el) => {
      const moduleId = el.dataset.moduleId!;
      const statusChip = el.querySelector<HTMLElement>("[data-rail-status]");
      if (!statusChip) return;

      if (isModuleComplete(moduleId)) {
        statusChip.textContent = "✓ COMPLETE";
        statusChip.classList.add("rail-status-chip--complete");
        statusChip.classList.remove("rail-status-chip--next");
      } else if (moduleId === next) {
        statusChip.textContent = "START";
        statusChip.classList.add("rail-status-chip--next");
        statusChip.classList.remove("rail-status-chip--complete");
      } else {
        statusChip.textContent = "TODO";
        statusChip.classList.remove("rail-status-chip--complete", "rail-status-chip--next");
      }
    });

    const summary = document.querySelector<HTMLElement>("[data-path-summary]");
    if (summary) {
      const { completed, total } = getCompletionSummary(moduleIds);
      summary.textContent = `${completed} of ${total} modules complete`;
    }
  }

  render();
  document.addEventListener("astro:page-load", render);

  function setupMilestones() {
    const strip = document.querySelector<HTMLElement>("[data-milestone-strip]");
    if (!strip || strip.dataset.milestonesBound === "true") return;
    strip.dataset.milestonesBound = "true";

    strip.addEventListener("click", (e) => {
      const btn = (e.target as HTMLElement).closest<HTMLButtonElement>("[data-milestone-for]");
      if (!btn) return;
      const moduleId = btn.dataset.milestoneFor;
      const railItem = document.querySelector<HTMLElement>(`[data-rail-item][data-module-id="${moduleId}"]`);
      if (!railItem) return;
      railItem.scrollIntoView({ behavior: "smooth", block: "center" });
      railItem.classList.add("is-pulsed");
      window.setTimeout(() => railItem.classList.remove("is-pulsed"), 900);
    });
  }

  setupMilestones();
  document.addEventListener("astro:page-load", setupMilestones);
</script>

<style>
  .path-page {
    padding-block: clamp(2.5rem, 6vw, 4rem);
  }

  .path-hero {
    max-width: 46rem;
    margin-bottom: 2.5rem;
  }

  .path-hero-chips {
    display: flex;
    gap: 0.6rem;
    margin-bottom: 1rem;
  }

  .path-title {
    font-size: clamp(2rem, 4vw, 2.75rem);
    margin: 0 0 0.75rem;
  }

  .path-outcome {
    font-size: 1.1rem;
    color: var(--accent-text, var(--accent));
    margin: 0 0 0.75rem;
  }

  .path-description {
    color: var(--text-secondary);
    line-height: 1.6;
    margin: 0 0 1.5rem;
  }

  .path-summary {
    color: var(--text-secondary);
  }

  .path-capabilities {
    list-style: none;
    margin: 0 0 1.25rem;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .path-capability-chip {
    font-size: 0.75rem;
    white-space: normal;
    text-align: left;
  }

  .milestone-strip {
    display: flex;
    gap: 0.6rem;
    overflow-x: auto;
    padding-bottom: 0.75rem;
    margin-bottom: 1.75rem;
    border-bottom: 2px solid var(--border);
  }

  .milestone-chip {
    flex: none;
    display: flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.45rem 0.75rem;
    background: var(--bg-card);
    border: 2px solid var(--border);
    border-radius: var(--radius);
    color: var(--text-secondary);
    font-size: 0.75rem;
    white-space: nowrap;
    cursor: pointer;
    transition: border-color var(--duration-micro) var(--ease-out), color var(--duration-micro) var(--ease-out);
  }

  .milestone-chip:hover,
  .milestone-chip:focus-visible {
    border-color: color-mix(in srgb, var(--accent) 45%, var(--border));
    color: var(--text);
  }

  .milestone-order {
    color: var(--text-secondary);
  }

  .rail-item.is-pulsed .rail-card {
    border-color: var(--accent);
    box-shadow: 0 0 0 1px color-mix(in srgb, var(--accent) 45%, transparent);
  }

  .module-rail {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .rail-item {
    position: relative;
  }

  .rail-card {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    padding: 1.25rem 1.5rem;
    text-decoration: none;
    color: inherit;
    transition:
      transform var(--duration-micro) var(--ease-out),
      border-color var(--duration-micro) var(--ease-out);
  }

  .rail-card:hover,
  .rail-card:focus-visible {
    transform: translateY(-2px);
    border-color: color-mix(in srgb, var(--accent) 45%, var(--glass-border));
  }

  .rail-order {
    flex: none;
    font-size: 1.3rem;
    font-weight: 700;
    color: var(--text-secondary);
    min-width: 2.5rem;
  }

  .rail-body {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    flex: 1;
    min-width: 0;
  }

  .rail-title {
    font-size: 1.05rem;
    font-weight: 600;
    color: var(--text);
  }

  .rail-summary {
    color: var(--text-secondary);
    font-size: 0.9rem;
    line-height: 1.5;
  }

  .rail-status {
    flex: none;
  }

  .rail-status-chip--complete {
    border-color: var(--accent);
    color: var(--accent-text, var(--accent));
  }

  .rail-status-chip--complete::before,
  .rail-status-chip--complete::after {
    color: var(--accent);
  }

  .rail-status-chip--next {
    border-color: var(--accent);
    background: color-mix(in srgb, var(--accent) 12%, var(--bg-card));
    color: var(--accent-text, var(--accent));
  }

  @media (max-width: 640px) {
    .rail-card {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.75rem;
    }
  }
</style>
