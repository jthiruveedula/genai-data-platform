---
/**
 * The scroll world: a camera flight through the platform, scrubbed by scroll.
 *
 * The six clips under `public/world/` are legs of ONE continuous three.js
 * render (Remotion, driven through OpenMontage's atelier composition path —
 * `tools/scroll-world/README.md`). Because they are slices of a single take
 * rather than separately generated shots, consecutive legs share a frame at
 * every boundary and the flight never cuts.
 *
 * Each room also carries the curriculum modules that teach it (data/worldRooms.ts),
 * which is what keeps the page a way into the site rather than a showpiece beside
 * it: every room is a deep link (`/world/#embed`), reachable by keyboard, and
 * marked with what you have already finished.
 *
 * This page is structure and copy only. The scrub mechanics live in
 * `src/scripts/world-scrub-engine.js` (vendored from the scroll-world skill).
 */
import ModernistLayout from "../layouts/ModernistLayout.astro";
import { roomModules, type RoomId } from "../data/worldRooms";

const base = import.meta.env.BASE_URL;
const asset = (file: string) => `${base}world/${file}`;
/** `01-sources` → `sources`: the ordinal is a render/encode detail, the hash is a name. */
const slugOf = (id: string) => id.replace(/^\d+-/, "");

type WorldSection = {
  id: RoomId;
  label: string;
  eyebrow: string;
  title: string;
  body: string;
  tags: string[];
  scroll?: number;
  linger?: number;
  cta?: { primary: { label: string; href: string }; secondary: { label: string; href: string } };
};

/** The ten pipeline stages of `data/platformScroll.ts`, grouped into the six
 *  rooms the camera actually flies through. Same story, one telling. */
const SECTIONS: WorldSection[] = [
  {
    id: "01-sources",
    label: "Sources",
    eyebrow: "01 · Raw",
    title: "Knowledge arrives messy.",
    body: "A scanned PDF, a ticket thread, a crawled page. Nothing is clean, nothing is labelled, and every decision downstream inherits whatever you do about it here.",
    tags: ["Documents", "Tickets", "Crawls"],
    scroll: 1.5,
    linger: 0.35,
  },
  {
    id: "02-ingest",
    label: "Ingest",
    eyebrow: "02 · Split",
    title: "Landed, parsed, chunked.",
    body: "Idempotent pipelines land every document in object storage with its metadata. Layout-aware parsing then splits it at semantic boundaries — chunk size echoes all the way out to answer quality.",
    tags: ["Object storage", "Layout-aware parse", "Incremental"],
  },
  {
    id: "03-embed",
    label: "Embed",
    eyebrow: "03 · Vectors",
    title: "Meaning becomes geometry.",
    body: "Each chunk collapses into a vector. Related things end up near each other, and search stops being string matching and starts being a distance problem you can reason about.",
    tags: ["Embeddings", "Similarity", "Dimensionality"],
    linger: 0.3,
  },
  {
    id: "04-index",
    label: "Index",
    eyebrow: "04 · Retrieve",
    title: "Ask, and the index answers.",
    body: "The question becomes a vector too. The store returns its nearest neighbours in milliseconds, and hybrid search puts keyword precision back alongside semantic recall.",
    tags: ["Vector DB", "Hybrid search", "Metadata filters"],
  },
  {
    id: "05-reason",
    label: "Reason",
    eyebrow: "05 · Rank",
    title: "Evidence, ranked before it is read.",
    body: "A reranker reorders what came back, the assembler fits the survivors into the context window, and only then does the model speak. The agent loop — plan, call a tool, observe — runs on the same floor.",
    tags: ["Rerank", "Context assembly", "Agent loop"],
    linger: 0.35,
  },
  {
    id: "06-answer",
    label: "Answer",
    eyebrow: "06 · Grounded",
    title: "An answer with receipts.",
    body: "Every claim traces to a chunk, every chunk to a document, and every call through one governed runtime: evaluated, observable, and accounted for down to the query.",
    tags: ["Citations", "Evals", "Observability"],
    scroll: 1.8,
    linger: 0.4,
    cta: {
      primary: { label: "Start the curriculum", href: `${base}modules/00-foundations/` },
      secondary: { label: "See the platform", href: base },
    },
  },
];

const config = {
  brand: { name: "GenAI Data Platform", href: base },
  hint: "scroll to fly",
  nav: true,
  atmosphere: false,
  diveScroll: 1.35,
  // The legs are consecutive frames of one render, so a seam needs only enough
  // dissolve to cover swapping one <video> element for the next — a wide
  // crossfade would blur two frames that already line up exactly.
  crossfade: 0.05,
  sections: SECTIONS.map((s) => ({
    id: s.id,
    slug: slugOf(s.id),
    label: s.label,
    eyebrow: s.eyebrow,
    title: s.title,
    body: s.body,
    tags: s.tags,
    scroll: s.scroll,
    linger: s.linger,
    cta: s.cta,
    still: asset(`${s.id}.jpg`),
    stillMobile: asset(`${s.id}-m.jpg`),
    clip: asset(`${s.id}.mp4`),
    clipMobile: asset(`${s.id}-m.mp4`),
    // The engine escapes every copy string it renders, so links can't be
    // smuggled through `body`. They are attached to the mounted copy instead
    // (and server-rendered into the fallback below, where crawlers find them).
    modules: roomModules(s.id).map((m) => ({
      id: m.id,
      title: m.title,
      href: `${base}modules/${m.id}/`,
    })),
  })),
  // Architecture A (one continuous forward take): the legs are the journey,
  // so there is nothing to connect them with.
  connectors: [],
};
---

<ModernistLayout
  title="The world"
  description="Scroll through a GenAI data platform as one continuous camera flight: raw documents, chunking, embeddings, the index, reranking, and a grounded answer."
  cloud="neutral"
>
  {/* The first scene's poster IS the largest contentful paint, and the engine
      only injects its <img> after the module script has run. Preloading it
      per breakpoint (the engine picks portrait or landscape at mount) takes
      that paint off the JavaScript's critical path. */}
  <link
    slot="head"
    rel="preload"
    as="image"
    href={asset("01-sources.jpg")}
    media="(min-width: 861px)"
    fetchpriority="high"
  />
  <link
    slot="head"
    rel="preload"
    as="image"
    href={asset("01-sources-m.jpg")}
    media="(max-width: 860px)"
    fetchpriority="high"
  />

  <div class="world" data-world></div>

  {/* The title plate. It is also the page's only <h1> once the engine has
      removed the static fallback, so it is real markup rather than something
      the client script paints — a heading that only exists after hydration is
      no heading at all. It clears itself on the first flick of scroll. */}
  <div class="world-plate" data-world-plate>
    <p class="world-plate__kicker">Six rooms · one continuous take</p>
    <h1 class="world-plate__title">One document<br />becomes an answer.</h1>
    <p class="world-plate__meta">
      Rendered locally, frame by frame — <a href={`${base}modules/00-foundations/`}>start the curriculum</a> or
      fly the route below.
    </p>
  </div>

  <!-- Everything above is built by JavaScript. This is the page without it:
       the same six sections, the same copy, each clip's own first frame as the
       image. Search engines and no-JS visitors get the story; the flight is
       the enhancement, not the content. -->
  <div class="world-fallback" data-world-fallback>
    <header class="world-fallback__head">
      <p class="world-fallback__kicker">The world</p>
      <h1>One document, six rooms, one continuous flight.</h1>
      <p class="world-fallback__lede">
        The scrolling camera version of this page needs JavaScript. Here is the same journey as stills.
      </p>
    </header>
    {
      SECTIONS.map((s) => (
        <section class="world-fallback__section" id={slugOf(s.id)}>
          <img
            src={asset(`${s.id}.jpg`)}
            alt={`Frame from the ${s.label.toLowerCase()} stage of the platform flight`}
            width="1280"
            height="720"
            loading="lazy"
            decoding="async"
          />
          <p class="world-fallback__eyebrow">{s.eyebrow}</p>
          <h2>{s.title}</h2>
          <p>{s.body}</p>
          <ul class="world-fallback__tags">
            {s.tags.map((t) => (
              <li>{t}</li>
            ))}
          </ul>
          <p class="world-fallback__taught">Learn this room:</p>
          <ul class="world-fallback__modules">
            {roomModules(s.id).map((m) => (
              <li>
                <a href={`${base}modules/${m.id}/`}>{m.title}</a>
              </li>
            ))}
          </ul>
          {s.cta && (
            <p class="world-fallback__cta">
              <a href={s.cta.primary.href}>{s.cta.primary.label}</a>
              <a href={s.cta.secondary.href}>{s.cta.secondary.label}</a>
            </p>
          )}
        </section>
      ))
    }
  </div>

  <script type="application/json" id="world-config" set:html={JSON.stringify(config)} />

  <script>
    import { mountScrollWorld } from "../scripts/world-scrub-engine.js";
    import { isModuleComplete } from "../lib/progress";

    type RoomModule = { id: string; title: string; href: string };
    type Room = { slug: string; label: string; modules: RoomModule[] };

    const host = document.querySelector<HTMLElement>("[data-world]");
    const raw = document.getElementById("world-config")?.textContent;
    if (host && raw) {
      const config = JSON.parse(raw) as { sections: Room[] };
      const rooms = config.sections;
      mountScrollWorld(host, config);

      const dots = [...host.querySelectorAll<HTMLButtonElement>(".sw-route__dot")];
      const copies = [...host.querySelectorAll<HTMLElement>(".sw-copy")];
      const reduced = matchMedia("(prefers-reduced-motion: reduce)").matches;

      // The engine's route dots carry their label in a tooltip span that the
      // phone breakpoint hides, which leaves the button with no accessible
      // name there. Naming them from the same config keeps the fix on this
      // side of the vendor boundary, so the engine file stays re-copyable.
      dots.forEach((dot, i) => {
        const label = rooms[i]?.label;
        if (label) dot.setAttribute("aria-label", `Fly to ${label}`);
      });

      // --- each room's curriculum modules, with what you've already finished ---
      // The engine escapes its copy strings, so this is attached after mount
      // rather than passed through `body`. Progress comes from the same
      // localStorage contract the module recaps write (lib/progress.ts), so a
      // room reflects work done anywhere on the site.
      copies.forEach((copy, i) => {
        const room = rooms[i];
        if (!room?.modules?.length) return;
        const done = room.modules.filter((m) => isModuleComplete(m.id)).length;

        const wrap = document.createElement("div");
        wrap.className = "world-taught";
        const head = document.createElement("p");
        head.className = "world-taught__head";
        head.textContent =
          done === room.modules.length
            ? `Learn this room · all ${room.modules.length} done`
            : `Learn this room · ${done}/${room.modules.length} done`;
        wrap.appendChild(head);

        const list = document.createElement("ul");
        list.className = "world-taught__list";
        for (const m of room.modules) {
          const li = document.createElement("li");
          const a = document.createElement("a");
          a.href = m.href;
          a.textContent = m.title;
          if (isModuleComplete(m.id)) {
            a.dataset.complete = "";
            // A checkmark glyph alone would read as punctuation to a screen
            // reader, so the state is in the accessible name too.
            a.setAttribute("aria-label", `${m.title} — complete`);
          }
          li.appendChild(a);
          list.appendChild(li);
        }
        wrap.appendChild(list);
        copy.appendChild(wrap);
      });

      // --- deep links: /world/#embed lands in that room, and the hash keeps up ---
      const slugs = rooms.map((r) => r.slug);
      const roomFromHash = () => slugs.indexOf(decodeURIComponent(location.hash.replace(/^#/, "")));
      const initial = roomFromHash();
      if (initial >= 0) {
        // After layout, or the engine's own scroll targets are still zero.
        requestAnimationFrame(() => dots[initial]?.click());
      }

      // A hash that changes without a document load — an in-page `#room` link,
      // the back button between two rooms, a pasted hash onto the URL already
      // open — has to fly there too. Reading the hash only at mount would make
      // deep links work on a cold load and silently do nothing otherwise.
      window.addEventListener("hashchange", () => {
        const i = roomFromHash();
        if (i >= 0) {
          dots[i]?.click();
          return;
        }
        // An empty hash can only arrive by history navigation — the flight
        // itself only ever writes room slugs. Back out of a room, and you get
        // the top of the flight (and the title plate) rather than being left
        // wherever the camera happened to be, which would make the URL and the
        // picture disagree.
        window.scrollTo({ top: 0, behavior: reduced ? "auto" : "smooth" });
      });

      // The engine already tracks the active room by toggling `is-active` on
      // the dots; observing that is cheaper (and always consistent with the
      // rail) than recomputing the scroll math here.
      let lastSlug = "";
      const routeObserver = new MutationObserver(() => {
        const i = dots.findIndex((d) => d.classList.contains("is-active"));
        const slug = slugs[i];
        if (!slug || slug === lastSlug) return;
        lastSlug = slug;
        history.replaceState(null, "", `#${slug}`);
      });
      for (const dot of dots) {
        routeObserver.observe(dot, { attributes: true, attributeFilter: ["class"] });
      }

      // --- keyboard: fly room to room without a mouse or a scroll wheel ---
      document.addEventListener("keydown", (event) => {
        if (event.metaKey || event.ctrlKey || event.altKey) return;
        const el = event.target as HTMLElement | null;
        if (el && (el.isContentEditable || /^(INPUT|TEXTAREA|SELECT)$/.test(el.tagName))) return;

        const current = Math.max(
          0,
          dots.findIndex((d) => d.classList.contains("is-active")),
        );
        let next: number | null = null;
        switch (event.key) {
          case "ArrowRight":
          case "ArrowDown":
          case "PageDown":
            next = Math.min(dots.length - 1, current + 1);
            break;
          case "ArrowLeft":
          case "ArrowUp":
          case "PageUp":
            next = Math.max(0, current - 1);
            break;
          case "Home":
            next = 0;
            break;
          case "End":
            next = dots.length - 1;
            break;
        }
        if (next === null || next === current) return;
        // Only now claim the key — an arrow press that doesn't move a room
        // should still scroll the page normally.
        event.preventDefault();
        dots[next]?.click();
      });

      // --- choreography: the plate, then the copy, one line at a time ---
      // Both are driven from a single rAF that reads what the engine already
      // wrote (the copy's inline opacity, the scroll position) rather than
      // installing a second scroll listener or a second source of truth.
      const root = document.documentElement;
      const plate = document.querySelector<HTMLElement>("[data-world-plate]");
      root.setAttribute("data-world-plate-visible", "");

      let plateUp = true;
      const live = new Array<boolean>(copies.length).fill(false);

      const choreograph = () => {
        // The plate holds the landing frame and clears on the first real flick
        // of scroll, handing the left column to the room copy underneath.
        const past = window.scrollY > window.innerHeight * 0.12;
        if (past === plateUp) {
          plateUp = !past;
          root.toggleAttribute("data-world-plate-visible", !past);
        }

        // A room's copy animates in as a sequence once the engine has brought
        // it up past half — the same threshold the engine uses to make it
        // clickable, so nothing animates that you can't yet interact with.
        for (let i = 0; i < copies.length; i++) {
          const shown = Number(copies[i].style.opacity || 0) > 0.55;
          if (shown !== live[i]) {
            live[i] = shown;
            copies[i].classList.toggle("is-live", shown);
          }
        }
        requestAnimationFrame(choreograph);
      };
      if (!reduced) {
        for (const copy of copies) copy.classList.add("is-choreographed");
      }
      if (plate) requestAnimationFrame(choreograph);

      // Only once the engine has actually built its DOM does the static
      // version get taken down — a thrown mount leaves the readable page up
      // rather than a blank screen. It is REMOVED, not just hidden: six more
      // posters left in a display:none subtree still get fetched, which is
      // ~400KB of bandwidth competing with the first clip.
      document.documentElement.setAttribute("data-world-mounted", "");
      document.querySelector("[data-world-fallback]")?.remove();
    }
  </script>
</ModernistLayout>

<style is:global>
  /* The engine ships light-mode defaults in an @layer, so unlayered variables
     here win. Bind them to the page's own Modernist tokens rather than to
     copies of them: the accent follows the cloud selection for free. */
  .sw-root {
    --sw-bg: var(--color-bg);
    --sw-ink: var(--color-text);
    --sw-ink-soft: var(--color-neutral-700);
    --sw-accent: var(--color-accent);
    --sw-font-display: var(--font-heading);
    --sw-font-body: var(--font-body);
  }

  /* Modernist has no rounded anything and one hard accent — square off the
     engine's default pill chrome instead of restyling it component by
     component. */
  .sw-root .sw-nav,
  .sw-root .sw-nav__item,
  .sw-root .sw-topcta,
  .sw-root .sw-btn,
  .sw-root .sw-copy__tags li,
  .sw-root .sw-route__label {
    border-radius: 0;
  }

  .sw-root .sw-brand__mark {
    border-radius: 0;
    background: var(--color-accent);
    box-shadow: none;
  }

  .sw-root .sw-copy__title,
  .sw-root .sw-brand__name {
    font-weight: var(--font-heading-weight);
    letter-spacing: -0.02em;
  }

  .sw-root .sw-nav {
    background: color-mix(in srgb, var(--color-bg) 82%, transparent);
    border: 1px solid var(--color-divider);
  }

  /* The engine's default tag chip mixes the accent into white; on this
     ground that lands under 4.5:1. Ink on surface, accent as the rule. */
  .sw-root .sw-copy__tags li {
    color: var(--color-text);
    background: color-mix(in srgb, var(--color-bg) 88%, transparent);
    border: 1px solid var(--color-accent);
  }

  .sw-root .sw-route__label {
    background: color-mix(in srgb, var(--color-bg) 88%, transparent);
    border: 1px solid var(--color-divider);
    color: var(--color-text);
  }

  .sw-root .sw-topcta {
    background: var(--color-text);
    color: var(--color-bg);
  }

  /* Paper on raw vermilion is 4.2:1 — fine for Modernist's own large-text
     buttons, under AA for the engine's 13-15px chrome. The 700 step of the
     same ramp clears 4.5:1 at these sizes without leaving the accent family.
     Applies to the active nav pill and the route label too. */
  .sw-root .sw-btn--primary,
  .sw-root .sw-nav__item.is-active {
    background: var(--color-accent-700);
    color: var(--color-bg);
  }

  .sw-root .sw-btn--ghost {
    border: 2px solid var(--color-text);
    color: var(--color-text);
  }

  [data-world-mounted] .world-fallback {
    display: none;
  }

  /* ---- cinematic chrome ------------------------------------------------- */

  /* A vignette and a pair of hairline mattes. The film is drawn in ink on
     paper, so "cinematic" here means the framing of a plate — a printed edge
     and a fall-off at the corners — not a dark filter over everything. */
  .sw-root .sw-stage::after {
    content: "";
    position: fixed;
    inset: 0;
    z-index: 15;
    pointer-events: none;
    background:
      radial-gradient(120% 90% at 50% 45%, transparent 55%, color-mix(in srgb, var(--color-text) 9%, transparent) 100%);
  }

  @media (min-width: 861px) {
    .sw-root .sw-stage::before {
      content: "";
      position: fixed;
      inset: 0;
      z-index: 16;
      pointer-events: none;
      border-top: 1.6vh solid var(--color-bg);
      border-bottom: 1.6vh solid var(--color-bg);
      box-shadow:
        inset 0 1.6vh 0 -1.5vh var(--color-divider),
        inset 0 -1.6vh 0 -1.5vh var(--color-divider);
    }
  }

  /* Chapter ticks on the progress rail: six rooms, so six divisions, rather
     than one undifferentiated bar. */
  .sw-root .sw-scrollbar {
    background:
      repeating-linear-gradient(
          90deg,
          var(--color-divider) 0 1px,
          transparent 1px calc(100% / 6)
        )
        no-repeat,
      color-mix(in srgb, var(--color-accent) 12%, transparent);
  }

  /* The title plate: the landing frame of the film. It occupies the same left
     column the room copy will, and the copy layer is held at zero opacity
     while it is up (see the rule below), so the two never stack. */
  .world-plate {
    position: fixed;
    z-index: 22;
    left: clamp(18px, 5vw, 64px);
    top: 50%;
    transform: translateY(-50%);
    width: min(46vw, 34rem);
    opacity: 0;
    pointer-events: none;
    transition:
      opacity 600ms cubic-bezier(0.16, 1, 0.3, 1),
      transform 600ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  /* Its own scrim. The engine's copy layer has one, but the plate sits above
     that layer, and the landing frame is the busiest in the film. */
  .world-plate::before {
    content: "";
    position: absolute;
    inset: -12vh -30vw -12vh -8vw;
    z-index: -1;
    pointer-events: none;
    background: linear-gradient(
      100deg,
      var(--color-bg) 0%,
      color-mix(in srgb, var(--color-bg) 86%, transparent) 42%,
      transparent 100%
    );
  }

  [data-world-plate-visible] .world-plate {
    opacity: 1;
    pointer-events: auto;
  }

  [data-world-mounted]:not([data-world-plate-visible]) .world-plate {
    transform: translateY(calc(-50% - 1.5rem));
  }

  .world-plate__kicker {
    margin: 0;
    font-size: 0.74rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--color-accent);
  }

  .world-plate__title {
    margin: 0.75rem 0 1rem;
    font-size: clamp(2.4rem, 5.6vw, 4.4rem);
    line-height: 0.98;
    letter-spacing: -0.03em;
  }

  .world-plate__meta {
    margin: 0;
    max-width: 34ch;
    color: var(--color-neutral-700);
    font-size: clamp(0.95rem, 1.2vw, 1.05rem);
  }

  .world-plate__meta a {
    color: var(--color-accent-700);
    font-weight: 600;
  }

  @media (max-width: 860px) {
    .world-plate {
      top: auto;
      bottom: calc(clamp(56px, 12dvh, 110px) + env(safe-area-inset-bottom));
      transform: none;
      right: clamp(18px, 5vw, 64px);
      width: auto;
    }

    [data-world-mounted]:not([data-world-plate-visible]) .world-plate {
      transform: translateY(-1rem);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .world-plate {
      transition: none;
    }
  }

  /* Hold the engine's copy while the title plate has the frame. Opacity on the
     LAYER multiplies with the per-room opacity the engine writes inline on
     each copy, so this composes instead of fighting it — no !important, and no
     second owner of the same property. Global because the layer is the
     engine's element, not this page's. */
  .sw-copylayer {
    transition: opacity 450ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  [data-world-plate-visible] .sw-copylayer {
    opacity: 0;
  }

  @media (prefers-reduced-motion: reduce) {
    .sw-copylayer {
      transition: none;
    }
  }

  /* ---- copy choreography ------------------------------------------------ */

  /* The engine fades a room's copy as a block. Under `is-choreographed` the
     block's children arrive in reading order instead, which is the difference
     between a caption appearing and a title sequence playing. Transforms and
     opacity only — no layout, so this costs nothing per frame. */
  .sw-root .sw-copy.is-choreographed > * {
    opacity: 0;
    transform: translateY(0.9rem);
    transition:
      opacity 520ms var(--ease-out, cubic-bezier(0.16, 1, 0.3, 1)),
      transform 520ms var(--ease-out, cubic-bezier(0.16, 1, 0.3, 1));
  }

  .sw-root .sw-copy.is-choreographed.is-live > * {
    opacity: 1;
    transform: none;
  }

  .sw-root .sw-copy.is-choreographed > .sw-copy__num {
    transition-delay: 0ms;
  }
  .sw-root .sw-copy.is-choreographed > .sw-copy__eyebrow {
    transition-delay: 70ms;
  }
  .sw-root .sw-copy.is-choreographed > .sw-copy__title {
