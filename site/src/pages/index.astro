---
import BaseLayout from "../layouts/BaseLayout.astro";
import HeroScene from "../components/home/HeroScene.astro";
import ResumeChip from "../components/home/ResumeChip.astro";
import ArchitectureStory from "../components/home/ArchitectureStory.astro";
import AgentLoopDiagram from "../components/home/AgentLoopDiagram.astro";
import IntegrationMap from "../components/home/IntegrationMap.astro";
import CloudFlavorDeck from "../components/home/CloudFlavorDeck.astro";
import OperateControlRoom from "../components/home/OperateControlRoom.astro";
import CurriculumJourney from "../components/home/CurriculumJourney.astro";
import CostConsole from "../components/home/CostConsole.astro";
import WhyItMatters from "../components/home/WhyItMatters.astro";
import FAQSection from "../components/home/FAQSection.astro";
import FinalCTA from "../components/home/FinalCTA.astro";
---

<BaseLayout
  title="Enterprise Agent Engineering"
  description="Design, build, integrate, and operate enterprise GenAI agent systems — RAG foundations through orchestration, governance, and production ops, on GCP, AWS, Azure, or OSS."
  fullBleed
>
  <HeroScene />
  <ResumeChip />
  <ArchitectureStory />
  <AgentLoopDiagram />
  <IntegrationMap />
  <CloudFlavorDeck />
  <OperateControlRoom />
  <CurriculumJourney />
  <CostConsole />
  <WhyItMatters />
  <FAQSection />
  <FinalCTA />
</BaseLayout>

<style is:global>
  /* Homepage scene rhythm: every scene manages its own internal layout, the
     page provides the shared width + vertical cadence. Scenes alternate
     between --bg and --bg-deep via their own backgrounds. */
  .main--full-bleed > section {
    padding: 6rem 0;
  }

  .main--full-bleed .scene-inner {
    max-width: 72rem;
    margin: 0 auto;
    padding: 0 1.5rem;
  }

  @media (max-width: 768px) {
    .main--full-bleed > section {
      padding: 4rem 0;
    }
  }
</style>
