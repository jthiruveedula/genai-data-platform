---
// One consolidated, scannable entry point for the real, cited enterprise
// case studies otherwise scattered one-per-module-per-cloud inside
// ModuleScenario. Every module already ships this data (scenarios.ts); this
// page is purely a different view over the same source of truth — no new
// facts, no invented numbers, same honest-copy rule as scenarios.ts itself.
import SiteLayout from "../layouts/SiteLayout.astro";
import { MODULES } from "../data/modules";
import { CASE_STUDIES } from "../data/scenarios";

const base = import.meta.env.BASE_URL;
const CLOUDS = ["gcp", "aws", "azure", "oss"] as const;

const ordered = [...MODULES].sort((a, b) => a.order - b.order);
const rows = ordered.map((m) => ({
  module: m,
  stories: CLOUDS.map((cloud) => ({ cloud, story: CASE_STUDIES[m.id][cloud] })),
}));

const totalStories = rows.length * CLOUDS.length;
const statCount = rows.reduce((sum, r) => sum + r.stories.filter((s) => s.story.stat).length, 0);

// Industry-wide 2026 survey data, distinct from the per-company case
// studies below: those are individual real outcomes, this is the aggregate
// picture across the whole market — including the honest downside numbers
// (governance failures, ROI misses), not just the wins. Same sourcing rule
// as scenarios.ts: every figure traces to a cited report, nothing invented.
const INDUSTRY_SNAPSHOT = [
  {
    value: "80%",
    label: "of enterprise apps shipped/updated in Q1 2026 embed at least one AI agent (up from 33% in 2024)",
    source: "Gartner",
    sourceUrl: "https://www.digitalapplied.com/blog/ai-agent-adoption-2026-enterprise-data-points",
  },
  {
    value: "6.4 hrs/wk",
    label: "median time recovered per seat by knowledge workers using production agents (10-12 hrs/wk for senior practitioners)",
    source: "Deloitte State of AI in the Enterprise 2026",
    sourceUrl: "https://sqmagazine.co.uk/ai-agents-statistics/",
  },
  {
    value: "9x",
    label: "cheaper per contained support ticket with an AI agent ($0.46) vs. a human-handled one ($4.18)",
    source: "Industry survey aggregate, 2026",
    sourceUrl: "https://sqmagazine.co.uk/ai-agents-statistics/",
  },
  {
    value: "14%",
    label: "more shipped features per engineer-quarter for teams using AI coding agents",
    source: "Stack Overflow / MIT Sloan, 2025-2026",
    sourceUrl: "https://www.digitalapplied.com/blog/ai-agent-adoption-2026-enterprise-data-points",
  },
  {
    value: "88%",
    label: "of enterprise AI agent pilots never reach production — the shipping gap this curriculum's eval/observability/FinOps modules exist to close",
    source: "DigitalApplied enterprise survey, 2026",
    sourceUrl: "https://www.digitalapplied.com/blog/ai-agent-adoption-2026-enterprise-data-points",
  },
  {
    value: "41%",
    label: "of agent rollouts cross positive ROI within 12 months (19% never reach payback at all)",
    source: "Gartner",
    sourceUrl: "https://sqmagazine.co.uk/ai-agents-statistics/",
  },
] as const;
---

<SiteLayout
  title="Enterprise case studies"
  description={`${totalStories} real, publicly cited enterprise case studies across all ${rows.length} curriculum modules and 4 clouds — no invented numbers, every figure sourced.`}
>
  <article>
    <header class="cs-hero">
      <div class="hero-meta">
        <span class="chip mono">[ {totalStories} REAL STORIES ]</span>
        <span class="chip mono">[ {rows.length} MODULES ]</span>
        <span class="chip mono">[ {statCount} WITH A HEADLINE NUMBER ]</span>
      </div>
      <h1>What real companies shipped with this.</h1>
      <p class="intro">
        Every module in this curriculum ships one real, publicly cited customer story per cloud — not a composite,
        not an invented number. This page pulls all {totalStories} of them into one place: what the company was
        solving, what they shipped, and the cited source. New to GenAI? Start here — this is the "why it matters"
        version of the curriculum, before any of the how.
      </p>
    </header>

    <section class="cs-snapshot" aria-labelledby="cs-snapshot-heading">
      <h2 id="cs-snapshot-heading" class="cs-snapshot-title">The industry picture, not just the wins</h2>
      <p class="cs-snapshot-intro">
        The stories below are real successes — but the honest industry-wide picture includes the failures too.
        Both sets of numbers are from cited 2026 surveys, not this curriculum's own claims.
      </p>
      <div class="cs-snapshot-grid">
        {
          INDUSTRY_SNAPSHOT.map((s) => (
            <div class="cs-snapshot-card">
              <p class="cs-snapshot-value mono">{s.value}</p>
              <p class="cs-snapshot-label">{s.label}</p>
              <p class="cs-snapshot-source">
                <a href={s.sourceUrl} target="_blank" rel="noopener noreferrer">
                  {s.source} ↗
                </a>
              </p>
            </div>
          ))
        }
      </div>
    </section>

    <div class="cs-groups">
      {
        rows.map((row) => (
          <section class="cs-group" aria-labelledby={`cs-${row.module.id}`}>
            <h2 id={`cs-${row.module.id}`} class="cs-group-title">
              <a href={`${base}modules/${row.module.id}/`}>{row.module.title}</a>
            </h2>
            <div class="cs-cards">
              {row.stories.map(({ cloud, story }) => (
                <article class="cs-card glass-panel">
                  <!-- Storyboard beats (redesign phase 4, issue #150):
                       Situation -> Architecture -> Outcome -> Source, all
                       from data already in scenarios.ts — no new/invented
                       facts, just a sequenced presentation instead of a
                       flat paragraph-in-a-card. -->
                  <p class="cs-beat-kicker mono">SITUATION</p>
                  <p class="cs-card-meta">
                    <span class="chip chip--accent">{cloud.toUpperCase()}</span>
                    <span class="chip mono">{story.industry}</span>
                    {story.stretch && (
                      <span class="chip chip--pending" title="Closest publicly available real match">
                        CLOSEST MATCH
                      </span>
                    )}
                  </p>
                  <p class="cs-card-company">{story.company}</p>
                  <p class="cs-card-vignette">{story.vignette}</p>

                  <p class="cs-beat-kicker mono">ARCHITECTURE</p>
                  <p class="cs-card-architecture">
                    <a class="chip" href={`${base}modules/${row.module.id}/`}>{row.module.title}</a>
                  </p>

                  {story.stat && (
                    <>
                      <p class="cs-beat-kicker mono">OUTCOME</p>
                      <p class="cs-card-stat">
                        <span
                          class="cs-card-stat-value mono"
                          data-cs-stat-value
                          data-target={story.stat.value}
                          data-decimals={story.stat.decimals ?? 0}
                          data-prefix={story.stat.prefix ?? ""}
                          data-suffix={story.stat.suffix}
                        >
                          {(story.stat.prefix ?? "") + story.stat.value + story.stat.suffix}
                        </span>
                        <span class="cs-card-stat-label">{story.stat.label}</span>
                      </p>
                    </>
                  )}

                  <p class="cs-card-source">
                    <a href={story.sourceUrl} target="_blank" rel="noopener noreferrer">
                      Source ↗
                    </a>
                  </p>
                </article>
              ))}
            </div>
          </section>
        ))
      }
    </div>
  </article>
</SiteLayout>

<script>
  import { countUp } from "../lib/motion/primitives";

  function setup() {
    const values = document.querySelectorAll<HTMLElement>("[data-cs-stat-value]");
    if (!values.length) return;
    if (typeof IntersectionObserver !== "function") {
      values.forEach((el) => animate(el));
      return;
    }
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;
          animate(entry.target as HTMLElement);
          observer.unobserve(entry.target);
        });
      },
      { rootMargin: "200px 0px" },
    );
    values.forEach((el) => observer.observe(el));
  }

  function animate(el: HTMLElement) {
    if (el.dataset.animated === "true") return;
    el.dataset.animated = "true";
    const target = Number(el.dataset.target ?? "0");
    countUp(el, target, {
      duration: 1,
      decimals: Number(el.dataset.decimals ?? "0"),
      prefix: el.dataset.prefix ?? "",
      suffix: el.dataset.suffix ?? "",
    });
  }

  setup();
  document.addEventListener("astro:page-load", setup);
</script>

<style>
  .cs-hero {
    padding-bottom: 1.5rem;
    margin-bottom: 2rem;
    border-bottom: 2px solid var(--border);
  }

  .hero-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: 0.85rem;
  }

  h1 {
    margin: 0 0 0.85rem;
    font-size: clamp(1.9rem, 4vw, 2.6rem);
    font-weight: 700;
    letter-spacing: -0.02em;
  }

  .intro {
    max-width: 48rem;
    color: var(--text-secondary);
    line-height: 1.6;
    font-size: 1.05rem;
  }

  .cs-snapshot {
    margin-bottom: 2.5rem;
    padding: 1.5rem;
    border: 2px solid var(--border);
    border-left: 3px solid var(--accent);
    border-radius: var(--radius);
    background: var(--bg-raised);
  }

  .cs-snapshot-title {
    margin: 0 0 0.5rem;
    font-size: 1.15rem;
  }

  .cs-snapshot-intro {
    margin: 0 0 1.25rem;
    max-width: 44rem;
    color: var(--text-secondary);
    font-size: 0.88rem;
    line-height: 1.55;
  }

  .cs-snapshot-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1rem;
  }

  .cs-snapshot-card {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    padding: 0.9rem 1rem;
    border: 2px solid var(--border);
    border-radius: var(--radius);
    background: var(--bg-card);
  }

  .cs-snapshot-value {
    font-size: 1.4rem;
    font-weight: 700;
    color: var(--accent-text, var(--accent));
  }

  .cs-snapshot-label {
    margin: 0;
    font-size: 0.78rem;
    color: var(--text-secondary);
    line-height: 1.45;
    flex: 1;
  }

  .cs-snapshot-source {
    margin: 0;
    font-family: var(--font-mono);
    font-size: 0.66rem;
  }

  .cs-snapshot-source a {
    color: var(--text-secondary);
  }

  .cs-snapshot-source a:hover {
    color: var(--accent-text, var(--accent));
  }

  @media (max-width: 1024px) {
    .cs-snapshot-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 640px) {
    .cs-snapshot-grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  .cs-groups {
    display: flex;
    flex-direction: column;
    gap: 2.5rem;
  }

  .cs-group-title {
    margin: 0 0 1rem;
    font-size: 1.3rem;
  }

  .cs-group-title a {
    color: var(--text);
    text-decoration: none;
  }

  .cs-group-title a:hover {
    color: var(--accent-text, var(--accent));
    text-decoration: underline;
  }

  .cs-cards {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 1rem;
  }

  .cs-card {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    padding: 1.1rem;
  }

  .cs-card-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin: 0;
  }

  .cs-card-company {
    margin: 0;
    font-weight: 700;
    font-size: 0.95rem;
  }

  .cs-card-stat {
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.1rem;
  }

  .cs-card-stat-value {
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--accent-text, var(--accent));
  }

  .cs-card-stat-label {
    font-size: 0.68rem;
    color: var(--text-secondary);
    font-family: var(--font-mono);
  }

  .cs-card-vignette {
    margin: 0;
    font-size: 0.82rem;
    line-height: 1.5;
    color: var(--text-secondary);
    flex: 1;
  }

  .cs-card-source {
    margin: 0;
    font-family: var(--font-mono);
    font-size: 0.68rem;
  }

  .cs-beat-kicker {
    margin: 0.35rem 0 -0.2rem;
    font-size: 0.6rem;
    letter-spacing: 0.1em;
    color: var(--text-secondary);
  }

  .cs-beat-kicker:first-child {
    margin-top: 0;
  }

  .cs-card-architecture {
    margin: 0;
  }

  .cs-card-architecture .chip {
    text-decoration: none;
    font-size: 0.7rem;
  }

  .cs-card-architecture .chip:hover {
    border-color: color-mix(in srgb, var(--accent) 45%, var(--border));
    color: var(--accent-text, var(--accent));
  }

  .cs-card-source a {
    color: var(--text-secondary);
  }

  .cs-card-source a:hover {
    color: var(--accent-text, var(--accent));
  }

  @media (max-width: 1024px) {
    .cs-cards {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 640px) {
    .cs-cards {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
