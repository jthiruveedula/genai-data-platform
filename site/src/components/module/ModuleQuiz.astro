---
import { QUIZZES } from "../../data/quizzes";

interface Props {
  moduleId: string;
}

const { moduleId } = Astro.props;
const questions = QUIZZES[moduleId];
if (!questions) throw new Error(`ModuleQuiz: no quiz registered for module "${moduleId}"`);
---

<section class="module-quiz glass-panel" data-module-quiz data-module-id={moduleId} aria-labelledby={`quiz-heading-${moduleId}`}>
  <header class="quiz-head">
    <p class="section-kicker">CHECKPOINT</p>
    <h2 class="quiz-title" id={`quiz-heading-${moduleId}`}>Test what stuck.</h2>
    <p class="quiz-lede">
      {questions.length} questions, scored instantly, nothing sent anywhere — your last score is remembered on this
      device.
    </p>
    <p class="chip mono quiz-last-score" data-quiz-last-score hidden></p>

    {/* How far through the quiz you are, before you commit to an answer. Five
        questions is enough to lose count of, and the submit button gives no
        hint about which one is still blank. */}
    <div class="quiz-progress" data-quiz-progress>
      <p class="quiz-progress-label mono" data-quiz-progress-label>
        0 / {questions.length} ANSWERED
      </p>
      <div class="quiz-progress-track" role="progressbar" aria-valuemin="0" aria-valuemax={questions.length} aria-valuenow="0" aria-label="Questions answered" data-quiz-progress-bar>
        <span class="quiz-progress-fill" data-quiz-progress-fill></span>
      </div>
    </div>
  </header>

  <form class="quiz-form" data-quiz-form novalidate>
    {
      questions.map((q, qi) => (
        <fieldset class="quiz-question" data-quiz-question={qi}>
          <legend class="quiz-question-text">
            <span class="quiz-question-number mono">Q{qi + 1}</span>
            {q.question}
          </legend>
          <div class="quiz-options" role="radiogroup">
            {q.options.map((option, oi) => (
              <label class="quiz-option" data-option-index={oi}>
                <input type="radio" name={`q${qi}`} value={oi} required />
                <span>{option}</span>
              </label>
            ))}
          </div>
          <p class="quiz-feedback" data-quiz-feedback hidden />
        </fieldset>
      ))
    }

    <div class="quiz-actions">
      <button type="submit" class="btn btn-primary" data-quiz-submit>
        Check answers
      </button>
      <button type="button" class="btn btn-ghost" data-quiz-retake hidden>
        Retake quiz
      </button>
      <p class="quiz-result chip chip--accent" data-quiz-result aria-live="polite" hidden></p>
    </div>
  </form>
</section>

<script>
  import { gsap } from "gsap";
  import { QUIZZES } from "../../data/quizzes";

  const reduceMotion = () => window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  function storageKey(moduleId: string) {
    return `gdp.quiz.${moduleId}`;
  }

  function loadLastScore(moduleId: string): { score: number; total: number } | null {
    try {
      const raw = localStorage.getItem(storageKey(moduleId));
      if (!raw) return null;
      const parsed = JSON.parse(raw);
      if (typeof parsed.score === "number" && typeof parsed.total === "number") return parsed;
      return null;
    } catch {
      return null;
    }
  }

  function saveScore(moduleId: string, score: number, total: number) {
    try {
      localStorage.setItem(storageKey(moduleId), JSON.stringify({ score, total, completedAt: Date.now() }));
    } catch {
      // localStorage unavailable (e.g. private mode) — score just won't persist across visits.
    }
  }

  function setup() {
    document.querySelectorAll<HTMLElement>("[data-module-quiz]").forEach((root) => {
      if (root.dataset.quizBound) return;
      root.dataset.quizBound = "true";

      const moduleId = root.dataset.moduleId!;
      const questions = QUIZZES[moduleId];
      const form = root.querySelector<HTMLFormElement>("[data-quiz-form]");
      const submitBtn = root.querySelector<HTMLButtonElement>("[data-quiz-submit]");
      const retakeBtn = root.querySelector<HTMLButtonElement>("[data-quiz-retake]");
      const resultEl = root.querySelector<HTMLElement>("[data-quiz-result]");
      const lastScoreEl = root.querySelector<HTMLElement>("[data-quiz-last-score]");
      if (!form || !questions) return;

      const last = loadLastScore(moduleId);
      if (last && lastScoreEl) {
        lastScoreEl.textContent = `LAST SCORE ${last.score}/${last.total}`;
        lastScoreEl.hidden = false;
      }

      const progress = root.querySelector<HTMLElement>("[data-quiz-progress]");
      const progressLabel = root.querySelector<HTMLElement>("[data-quiz-progress-label]");
      const progressBar = root.querySelector<HTMLElement>("[data-quiz-progress-bar]");
      const progressFill = root.querySelector<HTMLElement>("[data-quiz-progress-fill]");

      function paintProgress() {
        const answered = questions.filter((_, qi) => form!.querySelector(`input[name="q${qi}"]:checked`)).length;
        const total = questions.length;
        if (progressLabel) progressLabel.textContent = `${answered} / ${total} ANSWERED`;
        if (progressFill) progressFill.style.transform = `scaleX(${answered / total})`;
        progressBar?.setAttribute("aria-valuenow", String(answered));
        progress?.setAttribute("data-complete", String(answered === total));
      }

      form.addEventListener("change", paintProgress);
      paintProgress();

      function fieldsetFor(qi: number) {
        return root.querySelector<HTMLFieldSetElement>(`[data-quiz-question="${qi}"]`);
      }

      function resetQuiz() {
        form!.reset();
        questions.forEach((_, qi) => {
          const fs = fieldsetFor(qi);
          fs?.classList.remove("is-correct", "is-incorrect");
          fs?.querySelectorAll("[data-option-index]").forEach((el) => el.classList.remove("is-the-answer"));
          const feedback = fs?.querySelector<HTMLElement>("[data-quiz-feedback]");
          if (feedback) {
            feedback.hidden = true;
            feedback.textContent = "";
          }
          fs?.querySelectorAll("input").forEach((input) => (input.disabled = false));
        });
        if (resultEl) {
          resultEl.hidden = true;
          resultEl.textContent = "";
        }
        submitBtn!.hidden = false;
        retakeBtn!.hidden = true;
        paintProgress();
      }

      form.addEventListener("submit", (e) => {
        e.preventDefault();

        // Every radio group carries `required`, so an unanswered question
        // fails native constraint validation — bail out here (showing the
        // browser's built-in "please select one of these options" prompt)
        // rather than scoring it as simply wrong, which would reveal the
        // correct answer for a question the learner never attempted.
        if (!form!.checkValidity()) {
          form!.reportValidity();
          return;
        }

        let score = 0;

        questions.forEach((q, qi) => {
          const fs = fieldsetFor(qi);
          const feedback = fs?.querySelector<HTMLElement>("[data-quiz-feedback]");
          const selected = fs?.querySelector<HTMLInputElement>(`input[name="q${qi}"]:checked`);
          const isCorrect = selected ? Number(selected.value) === q.correctIndex : false;

          fs?.classList.toggle("is-correct", isCorrect);
          fs?.classList.toggle("is-incorrect", !isCorrect);
          fs?.querySelectorAll("input").forEach((input) => (input.disabled = true));

          if (!isCorrect) {
            fs?.querySelector(`[data-option-index="${q.correctIndex}"]`)?.classList.add("is-the-answer");
          }

          if (feedback) {
            feedback.hidden = false;
            feedback.textContent = isCorrect ? "Correct." : `Not quite — ${q.explanation}`;
          }

          if (isCorrect) score++;
        });

        saveScore(moduleId, score, questions.length);

        const verdict = score >= questions.length * 0.7 ? "PASS" : "SCORE";
        if (resultEl) {
          resultEl.hidden = false;
          resultEl.textContent = `[ ${verdict} ${score}/${questions.length} ]`;
        }
        submitBtn!.hidden = true;
        retakeBtn!.hidden = false;
        retakeBtn!.focus();

        revealMarking(root, resultEl, verdict, score, questions.length);
        goToFirstMiss(root);
      });

      retakeBtn?.addEventListener("click", resetQuiz);
    });
  }

  /**
   * Five questions score at once, so the marking lands as one undifferentiated
   * wall of red and green. Walking it down the page in order gives the eye
   * somewhere to start, and counts the score up to the number it landed on
   * instead of just stamping it there.
   */
  function revealMarking(
    root: HTMLElement,
    resultEl: HTMLElement | null,
    verdict: string,
    score: number,
    total: number,
  ) {
    const marks = [...root.querySelectorAll<HTMLElement>("[data-quiz-feedback]")].filter((el) => !el.hidden);
    // Under reduced motion the marking is already in its final state: the
    // classes and the explanation text are set before this runs.
    if (reduceMotion()) return;

    const tl = gsap.timeline();
    tl.from(marks, { autoAlpha: 0, y: -6, duration: 0.3, ease: "power2.out", stagger: 0.07 });

    if (resultEl) {
      const counter = { v: 0 };
      tl.to(
        counter,
        {
          v: score,
          duration: 0.5,
          ease: "power1.out",
          onUpdate: () => {
            resultEl.textContent = `[ ${verdict} ${Math.round(counter.v)}/${total} ]`;
          },
          onComplete: () => {
            resultEl.textContent = `[ ${verdict} ${score}/${total} ]`;
          },
        },
        0.15,
      );
    }
  }

  /**
   * The quiz is taller than a viewport, so after scoring the learner is often
   * looking at the submit button with every explanation off-screen above.
   * Take them to the first thing they got wrong — or leave them be if there
   * isn't one.
   */
  function goToFirstMiss(root: HTMLElement) {
    const miss = root.querySelector<HTMLElement>(".quiz-question.is-incorrect");
    if (!miss) return;
    miss.scrollIntoView({ behavior: reduceMotion() ? "auto" : "smooth", block: "center" });
  }

  setup();
  document.addEventListener("astro:page-load", setup);
</script>

<style>
  .module-quiz {
    margin-top: 3rem;
    padding: 1.75rem 2rem 2rem;
    /* A quiz is a form, not a diagram: the site's full-width rule is for
       things you scan, and an answer you have to read across 1400px of
       screen is neither scannable nor comfortably clickable. */
    max-width: 62rem;
  }

  .quiz-progress {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-top: 0.9rem;
  }

  .quiz-progress-label {
    margin: 0;
    flex: 0 0 auto;
    font-size: 0.68rem;
    letter-spacing: 0.08em;
    color: var(--text-secondary);
  }

  .quiz-progress-track {
    flex: 1 1 auto;
    max-width: 18rem;
    height: 2px;
    background: var(--border);
  }

  .quiz-progress-fill {
    display: block;
    height: 100%;
    width: 100%;
    background: var(--accent);
    transform: scaleX(0);
    transform-origin: 0 50%;
    transition: transform var(--duration-base, 300ms) var(--ease-out, ease);
  }

  .quiz-progress[data-complete="true"] .quiz-progress-label {
    color: var(--accent-text, var(--accent));
  }

  @media (prefers-reduced-motion: reduce) {
    .quiz-progress-fill {
      transition: none;
    }
  }

  .quiz-head {
    margin-bottom: 1.5rem;
  }

  .quiz-title {
    font-size: 1.4rem;
    font-weight: 800;
    letter-spacing: -0.01em;
    margin: 0.5rem 0 0.5rem;
  }

  .quiz-lede {
    margin: 0 0 0.75rem;
    color: var(--text-secondary);
  }

  .quiz-last-score {
    width: fit-content;
  }

  .quiz-form {
    display: flex;
    flex-direction: column;
    gap: 1.75rem;
  }

  .quiz-question {
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 1.1rem 1.25rem 1.25rem;
    margin: 0;
    transition: border-color var(--duration-micro) var(--ease-out);
  }

  .quiz-question-text {
    display: flex;
    align-items: baseline;
    gap: 0.6rem;
    font-weight: 600;
    padding: 0;
    margin-bottom: 0.85rem;
  }

  .quiz-question-number {
    color: var(--accent-text, var(--accent));
    font-size: 0.8rem;
  }

  .quiz-options {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .quiz-option {
    display: flex;
    align-items: flex-start;
    gap: 0.6rem;
    min-height: 44px;
    padding: 0.5rem 0.7rem;
    border-radius: calc(var(--radius) * 0.75);
    cursor: pointer;
    transition: background-color var(--duration-micro) var(--ease-out);
  }

  .quiz-option:hover {
    background: var(--bg-raised);
  }

  /* Marks the selected option via the label, not just the native radio dot —
     browsers render disabled radios at low contrast (barely visible on a
     dark surface), and inputs are disabled the moment a question is
     scored, so without this the learner can't tell which answer they
     picked once feedback appears. */
  .quiz-option:has(input:checked) {
    background: var(--bg-raised);
    box-shadow: inset 0 0 0 1.5px var(--border);
  }

  .quiz-question.is-correct .quiz-option:has(input:checked) {
    box-shadow: inset 0 0 0 1.5px var(--accent);
  }

  .quiz-question.is-incorrect .quiz-option:has(input:checked) {
    box-shadow: inset 0 0 0 1.5px var(--text-secondary);
  }

  .quiz-option input {
    margin-top: 0.25rem;
    accent-color: var(--accent);
  }

  /* Marks the correct option when the learner picked the wrong one — shown
     alongside the explanation text so the right answer is visible, not
     just described. */
  .quiz-option.is-the-answer {
    box-shadow: inset 0 0 0 1.5px var(--accent);
  }

  .quiz-option.is-the-answer::after {
    content: "correct answer";
    margin-left: auto;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    color: var(--accent-text, var(--accent));
  }

  .quiz-question.is-correct {
    border-color: var(--accent);
  }

  .quiz-question.is-incorrect {
    border-color: color-mix(in srgb, var(--text-secondary) 60%, transparent);
  }

  .quiz-feedback {
    margin: 0.85rem 0 0;
    font-size: 0.88rem;
    color: var(--text-secondary);
  }

  .quiz-question.is-correct .quiz-feedback {
    color: var(--accent-text, var(--accent));
  }

  .quiz-actions {
    display: flex;
    align-items: center;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .quiz-result {
    font-size: 0.85rem;
  }
</style>
