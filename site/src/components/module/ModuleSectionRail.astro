---
/**
 * A section rail for long module pages: the page's own headings, tracked as you
 * read, clickable to jump.
 *
 * The headings are not duplicated into data — they are read out of the rendered
 * article, so the rail cannot disagree with the page. It builds itself only when
 * there are enough sections to be worth a rail (3+), and only on viewports wide
 * enough to hold it beside the column, so nothing is crowded on the way down to
 * a phone.
 *
 * The site already has a reading-progress rule (SiteLayout); this answers the
 * other question — not "how far through am I" but "what is in here, and where
 * am I in it".
 */
---

<nav class="section-rail" data-section-rail aria-label="Sections in this module" hidden>
  <ol class="rail-list" data-rail-list></ol>
</nav>

<!-- The same headings, for the widths the tick rail refuses: below 1024px
     there is no page edge to put ticks in, and until now that meant a phone
     got no section navigation at all on a page that scrolls for six or seven
     screens. A thumb-height pill instead, naming where you are, opening into
     the list. -->
<nav class="section-sheet" data-section-sheet aria-label="Sections in this module" hidden>
  <button
    type="button"
    class="sheet-toggle"
    data-sheet-toggle
    aria-expanded="false"
    aria-controls="section-sheet-list"
  >
    <span class="sheet-caret" aria-hidden="true">^</span>
    <span class="sheet-current" data-sheet-current></span>
    <span class="sheet-count mono" data-sheet-count></span>
  </button>
  <ol class="sheet-list" id="section-sheet-list" data-sheet-list hidden></ol>
</nav>

<style is:global>
  /* The permalink mark beside every module heading. Hidden until the heading
     is hovered or the mark is focused, so it never competes with the title. */
  .head-anchor {
    display: inline-block;
    margin-left: 0.4rem;
    text-decoration: none;
    color: var(--accent);
    opacity: 0;
    font-weight: 400;
    transition: opacity var(--duration-micro, 120ms) var(--ease-out, ease);
  }

  .head-anchor::after {
    content: "#";
  }

  .head-anchor[data-copied]::after {
    content: "copied";
    font-family: var(--font-mono);
    font-size: 0.6em;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  h2:hover > .head-anchor,
  .head-anchor:focus-visible,
  .head-anchor[data-copied] {
    opacity: 1;
  }

  /* Coarse pointers have no hover to reveal it with, so it is always there —
     quietly, since it sits beside every heading on the page. */
  @media (pointer: coarse) {
    .head-anchor {
      opacity: 0.3;
    }
  }

  /* Room for the section pill, which is fixed over the foot of the page on
     the widths that get it. Global rather than scoped because the element it
     has to clear is the document, and this component only renders on the
     module pages that carry the pill. */
  @media (max-width: 1023px) {
    body {
      padding-bottom: 4.5rem;
    }
  }

  /* A hash landing must not tuck the heading under the sticky nav. */
  article h2[id] {
    scroll-margin-top: 5rem;
  }

  @media (prefers-reduced-motion: reduce) {
    .head-anchor {
      transition: none;
    }
  }
</style>

<style>
  /* A tick rail, not a panel: the reading column on this site runs nearly the
     full width at large sizes, so a box of section titles would sit on top of
     the prose. Ticks live in the page edge and cost ~10px; the title appears
     on hover or keyboard focus, which is when it is actually wanted. */
  .section-rail {
    position: fixed;
    top: 50%;
    right: max(0.4rem, env(safe-area-inset-right));
    z-index: 30;
    transform: translateY(-50%);
    padding: 0.4rem 0.25rem;
  }

  /* Below this there is no edge to spare, and the page is a single column. */
  @media (max-width: 1023px) {
    .section-rail {
      display: none;
    }
  }

  .rail-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.55rem;
  }

  .rail-list :global(button) {
    position: relative;
    display: block;
    width: 1.4rem;
    height: 0.85rem;
    font: inherit;
    background: none;
    border: 0;
    padding: 0;
    cursor: pointer;
  }

  /* The tick itself. */
  .rail-list :global(button::before) {
    content: "";
    position: absolute;
    right: 0;
    top: 50%;
    height: 2px;
    width: 0.75rem;
    transform: translateY(-50%);
    background: var(--border);
    transition:
      width var(--duration-micro) var(--ease-out),
      background var(--duration-micro) var(--ease-out);
  }

  .rail-list :global(button:hover::before),
  .rail-list :global(button:focus-visible::before) {
    width: 1.4rem;
    background: var(--accent);
  }

  .rail-list :global(button[aria-current="true"]::before) {
    width: 1.4rem;
    background: var(--accent);
  }

  /* The label, revealed beside the tick on hover/focus. */
  .rail-list :global(.rail-label) {
    position: absolute;
    right: 1.75rem;
    top: 50%;
    transform: translateY(-50%) translateX(0.3rem);
    white-space: nowrap;
    max-width: 22rem;
    overflow: hidden;
    text-overflow: ellipsis;
    font-size: 0.75rem;
    line-height: 1.2;
    color: var(--text);
    background: color-mix(in srgb, var(--bg-card) 94%, transparent);
    border: 1px solid var(--border);
    padding: 0.25rem 0.5rem;
    border-radius: var(--radius);
    opacity: 0;
    pointer-events: none;
    transition:
      opacity var(--duration-micro) var(--ease-out),
      transform var(--duration-micro) var(--ease-out);
  }

  .rail-list :global(button:hover .rail-label),
  .rail-list :global(button:focus-visible .rail-label),
  /* While the page is moving, the current section names itself — that is when
     "where am I" is the live question. It used to be painted permanently,
     which parked a label on top of the full-width demos and quiz panels that
     run under the rail. */
  .section-rail[data-scrolling="true"] .rail-list :global(button[aria-current="true"] .rail-label) {
    opacity: 1;
    transform: translateY(-50%) translateX(0);
  }

  @media (prefers-reduced-motion: reduce) {
    .rail-list :global(button::before),
    .rail-list :global(.rail-label) {
      transition: none;
    }
  }

  /* ---- the small-viewport sheet ---------------------------------------- */

  .section-sheet {
    position: fixed;
    left: 50%;
    bottom: max(0.75rem, env(safe-area-inset-bottom));
    z-index: 40;
    transform: translateX(-50%);
    width: min(28rem, calc(100vw - 1.5rem));
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  /* Above this the tick rail owns the job, and two navigators for one set of
     headings is one too many. */
  @media (min-width: 1024px) {
    .section-sheet {
      display: none;
    }
  }

  .sheet-toggle {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    width: 100%;
    min-height: 44px;
    padding: 0.55rem 0.9rem;
    font: inherit;
    font-size: 0.85rem;
    text-align: left;
    color: var(--text);
    background: var(--bg-card);
    border: 2px solid var(--border);
    border-radius: 999px;
    box-shadow: 0 10px 24px -14px rgb(0 0 0 / 0.4);
    cursor: pointer;
  }

  .sheet-toggle:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }

  .sheet-caret {
    flex: 0 0 auto;
    font-family: var(--font-mono);
    color: var(--accent-text, var(--accent));
    transition: transform var(--duration-micro, 120ms) var(--ease-out, ease);
  }

  .section-sheet[data-open="true"] .sheet-caret {
    transform: rotate(180deg);
  }

  .sheet-current {
    flex: 1 1 auto;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .sheet-count {
    flex: 0 0 auto;
    font-size: 0.7rem;
    letter-spacing: 0.06em;
    color: var(--text-secondary);
  }

  /* Opens upward: the control is at the bottom of the screen, so the list has
     to grow away from the thumb rather than under it. */
  .sheet-list {
    order: -1;
    list-style: none;
    margin: 0 0 0.5rem;
    padding: 0.4rem;
    max-height: min(60vh, 22rem);
    overflow-y: auto;
    background: var(--bg-card);
    border: 2px solid var(--border);
    border-radius: var(--radius);
    box-shadow: 0 16px 32px -18px rgb(0 0 0 / 0.45);
  }

  .sheet-list[hidden] {
    display: none;
  }

  .sheet-list :global(button) {
    display: flex;
    align-items: baseline;
    gap: 0.55rem;
    width: 100%;
    min-height: 44px;
    padding: 0.45rem 0.6rem;
    font: inherit;
    font-size: 0.85rem;
    text-align: left;
    color: var(--text);
    background: none;
    border: 0;
    border-radius: calc(var(--radius) * 0.75);
    cursor: pointer;
  }

  .sheet-list :global(button[aria-current="true"]) {
    background: color-mix(in srgb, var(--accent) 10%, transparent);
    color: var(--accent-text, var(--accent));
    font-weight: 700;
  }

  .sheet-list :global(.sheet-index) {
    flex: 0 0 auto;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    color: var(--text-secondary);
  }

  .sheet-list :global(button[aria-current="true"] .sheet-index) {
    color: var(--accent-text, var(--accent));
  }

  @media (prefers-reduced-motion: reduce) {
    .sheet-caret {
      transition: none;
    }
  }
</style>

<script>
  /** Heading text to a URL fragment: lowercase words joined by hyphens. */
  function slugify(text: string): string {
    return text
      .toLowerCase()
      .replace(/[^\w\s-]/g, "")
      .trim()
      .replace(/\s+/g, "-")
      .slice(0, 60);
  }

  /**
   * A permalink mark beside the heading. Its label lives in `aria-label` and
   * its glyph in CSS `::after`, so the heading's own text is unchanged — the
   * rail reads that text for its tick names, and so does the site search.
   */
  function addAnchor(heading: HTMLElement, title: string) {
    if (heading.querySelector(".head-anchor")) return;
    const anchor = document.createElement("a");
    anchor.className = "head-anchor";
    anchor.href = `#${heading.id}`;
    anchor.setAttribute("aria-label", `Copy link to section: ${title}`);
    anchor.addEventListener("click", (event) => {
      // Let the hash navigation happen; copying the resulting URL is the part
      // a reader actually wants, and the address bar is a poor place to do it.
      const url = `${location.origin}${location.pathname}#${heading.id}`;
      navigator.clipboard?.writeText(url).then(
        () => {
          anchor.dataset.copied = "true";
          window.setTimeout(() => delete anchor.dataset.copied, 1400);
        },
        () => {
          /* Clipboard denied (permissions, insecure origin) — the link still
             navigated, which is the fallback. */
        },
      );
      void event;
    });
    heading.appendChild(anchor);
  }

  /**
   * Jump to a section and stay there. The second half matters on these pages:
   * the 3D mechanism and the demos hydrate lazily, and an island above the
   * target growing mid-scroll leaves the reader a few hundred pixels short of
   * the heading they clicked. Once the scroll settles, re-aim if the heading
   * did not end up where `scroll-margin-top` says it should.
   */
  function jumpTo(heading: HTMLElement) {
    const reduce = matchMedia("(prefers-reduced-motion: reduce)").matches;
    heading.scrollIntoView({ behavior: reduce ? "auto" : "smooth", block: "start" });
    // Give the heading focus as well as the scroll, so keyboard and
    // screen-reader users land where the page just moved to.
    heading.tabIndex = -1;
    heading.focus({ preventScroll: true });

    const settle = () => {
      const want = parseFloat(getComputedStyle(heading).scrollMarginTop) || 0;
      if (Math.abs(heading.getBoundingClientRect().top - want) > 4) {
        heading.scrollIntoView({ behavior: "auto", block: "start" });
      }
    };
    if ("onscrollend" in window) window.addEventListener("scrollend", settle, { once: true });
    else window.setTimeout(settle, 600);
  }

  /**
   * The same headings as a bottom-anchored sheet, for the widths where the
   * tick rail hides itself. Returns null when there is no sheet in the page.
   */
  function buildSheet(headings: HTMLElement[], titles: string[]) {
    const sheet = document.querySelector<HTMLElement>("[data-section-sheet]");
    const toggle = sheet?.querySelector<HTMLButtonElement>("[data-sheet-toggle]");
    const list = sheet?.querySelector<HTMLElement>("[data-sheet-list]");
    const currentEl = sheet?.querySelector<HTMLElement>("[data-sheet-current]");
    const countEl = sheet?.querySelector<HTMLElement>("[data-sheet-count]");
    if (!sheet || !toggle || !list || !currentEl || !countEl) return null;

    list.textContent = "";
    const items: HTMLButtonElement[] = [];
    headings.forEach((heading, i) => {
      const li = document.createElement("li");
      const button = document.createElement("button");
      button.type = "button";
      const index = document.createElement("span");
      index.className = "sheet-index";
      index.textContent = String(i + 1).padStart(2, "0");
      const label = document.createElement("span");
      label.textContent = titles[i];
      button.append(index, label);
      button.addEventListener("click", () => {
        close();
        jumpTo(heading);
      });
      li.appendChild(button);
      list.appendChild(li);
      items.push(button);
    });

    function open() {
      list!.hidden = false;
      sheet!.setAttribute("data-open", "true");
      toggle!.setAttribute("aria-expanded", "true");
      // Open on the section you are in, not at the top of a list you have
      // already scrolled past.
      list!.querySelector<HTMLElement>('button[aria-current="true"]')?.scrollIntoView({ block: "nearest" });
    }

    function close() {
      list!.hidden = true;
      sheet!.removeAttribute("data-open");
      toggle!.setAttribute("aria-expanded", "false");
    }

    // buildRail runs at module eval and again on astro:page-load — which fires
    // for the first load too. The list is rebuilt each time, but the toggle is
    // static markup, so binding it twice made one tap open and close again.
    if (!sheet.dataset.sheetBound) {
      sheet.dataset.sheetBound = "true";

      toggle.addEventListener("click", () => {
        if (toggle.getAttribute("aria-expanded") === "true") close();
        else open();
      });

      document.addEventListener("keydown", (e) => {
        if (e.key !== "Escape" || toggle.getAttribute("aria-expanded") !== "true") return;
        close();
        toggle.focus();
      });

      document.addEventListener("pointerdown", (e) => {
        if (!sheet.isConnected || toggle.getAttribute("aria-expanded") !== "true") return;
        if ((e.target as HTMLElement).closest("[data-section-sheet]")) return;
        close();
      });
    }

    countEl.textContent = `1/${headings.length}`;
    currentEl.textContent = titles[0];
    sheet.hidden = false;

    return {
      setCurrent(i: number) {
        currentEl.textContent = titles[i];
        countEl.textContent = `${i + 1}/${headings.length}`;
        items.forEach((button, n) => {
          if (n === i) button.setAttribute("aria-current", "true");
          else button.removeAttribute("aria-current");
        });
      },
    };
  }

  function buildRail() {
    const rail = document.querySelector<HTMLElement>("[data-section-rail]");
    const list = rail?.querySelector<HTMLElement>("[data-rail-list]");
    const article = document.querySelector("article");
    if (!rail || !list || !article) return;

    const headings = [...article.querySelectorAll<HTMLElement>("h2")].filter(
      (h) => (h.textContent ?? "").trim().length > 0,
    );
    // Read every title before anything is appended into the headings below, so
    // a rail tick is never named after its own anchor mark.
    const titles = headings.map((h) => (h.textContent ?? "").trim());

    // Stable, shareable ids come first and unconditionally: a two-section page
    // gets no rail but still deserves a link you can send someone.
    const taken = new Set<string>();
    headings.forEach((heading, i) => {
      if (!heading.id) {
        const base = slugify(titles[i]) || `section-${i + 1}`;
        // Two sections can legitimately share a title across a long page; the
        // fragment cannot, or the second one is unreachable.
        let id = base;
        let n = 2;
        while (taken.has(id) || document.getElementById(id)) id = `${base}-${n++}`;
        heading.id = id;
      }
      taken.add(heading.id);
      addAnchor(heading, titles[i]);
    });

    // Two sections do not need a rail; they need a scroll.
    if (headings.length < 3) return;

    list.textContent = "";
    const buttons: HTMLButtonElement[] = [];

    headings.forEach((heading, i) => {
      const li = document.createElement("li");
      const title = titles[i];
      const button = document.createElement("button");
      button.type = "button";
      // The tick is the control; the title is its accessible name and its
      // hover label, so the button is never an unnamed dot.
      button.setAttribute("aria-label", title);
      const label = document.createElement("span");
      label.className = "rail-label";
      label.setAttribute("aria-hidden", "true");
      label.textContent = title;
      button.appendChild(label);
      button.addEventListener("click", () => jumpTo(heading));
      li.appendChild(button);
      list.appendChild(li);
      buttons.push(button);
    });

    rail.hidden = false;
    const sheet = buildSheet(headings, titles);

    // Track the heading nearest the top of the viewport rather than whatever is
    // merely intersecting: with several short sections on screen at once,
    // "intersecting" flickers between them.
    let ticking = false;
    const mark = () => {
      ticking = false;
      const cutoff = window.innerHeight * 0.35;
      let current = 0;
      headings.forEach((heading, i) => {
        if (heading.getBoundingClientRect().top <= cutoff) current = i;
      });
      buttons.forEach((button, i) => {
        if (i === current) button.setAttribute("aria-current", "true");
        else button.removeAttribute("aria-current");
      });
      sheet?.setCurrent(current);
    };
    let idleTimer: number | undefined;
    window.addEventListener(
      "scroll",
      () => {
        rail.setAttribute("data-scrolling", "true");
        window.clearTimeout(idleTimer);
        idleTimer = window.setTimeout(() => rail.removeAttribute("data-scrolling"), 900);
        if (ticking) return;
        ticking = true;
        requestAnimationFrame(mark);
      },
      { passive: true },
    );
    mark();
  }

  buildRail();
  document.addEventListener("astro:page-load", buildRail);
</script>
