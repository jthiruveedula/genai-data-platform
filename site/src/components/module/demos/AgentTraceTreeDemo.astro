---
// Bespoke concept demo for Module 55 (Observability) — the agent-loop
// counterpart to TraceWaterfallDemo's flat 4-stage RAG waterfall. Same
// visual language (indented rows instead of a single bar per row) so the
// contrast is legible at a glance: a RAG trace is one row per stage: an
// agent trace is a tree, with a row per loop iteration and nested rows per
// tool call inside it.
const NODES = [
  { label: "Iteration 1 · tool call: search_docs", ms: 40, depth: 0 },
  { label: "↳ retrieve (Module 35)", ms: 18, depth: 1 },
  { label: "Iteration 2 · tool call: compare_versions", ms: 65, depth: 0 },
  { label: "↳ retrieve (Module 35)", ms: 20, depth: 1 },
  { label: "↳ generate diff", ms: 30, depth: 1 },
  { label: "Iteration 3 · generate final answer", ms: 120, depth: 0 },
];
const TOTAL = NODES.reduce((sum, n) => sum + n.ms, 0);
let cursor = 0;
const ROWS = NODES.map((n) => {
  const start = cursor;
  cursor += n.ms;
  return { ...n, start };
});
---

<figure class="concept-demo trace-tree-demo" data-trace-tree-demo aria-label="An agent loop's trace, shown as a tree of nested spans">
  <figcaption class="concept-demo-label mono">[ SEE IT: AN AGENT LOOP'S TRACE IS A TREE, NOT A WATERFALL ]</figcaption>

  <div class="trace-tree-rows">
    {
      ROWS.map((n) => (
        <div class="trace-tree-row" style={`--depth:${n.depth}`}>
          <span class="trace-tree-label mono">{n.label}</span>
          <div class="trace-tree-track">
            <span
              class="trace-tree-bar"
              data-trace-tree-item
              data-depth={n.depth}
              style={`left:${(n.start / TOTAL) * 100}%; width:${(n.ms / TOTAL) * 100}%;`}
            />
          </div>
          <span class="trace-tree-ms mono">{n.ms}ms</span>
        </div>
      ))
    }
  </div>

  <p class="trace-tree-total mono">
    TOTAL: {TOTAL}ms across 3 loop iterations — flatten this back into one waterfall and you lose which iteration, and
    which nested tool call, was the slow one.
  </p>
</figure>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);

  let ctx: gsap.Context | undefined;

  function setup() {
    const rootEl = document.querySelector<HTMLElement>("[data-trace-tree-demo]");
    if (!rootEl) return;
    ctx?.revert();
    ctx = gsap.context(() => {
      const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
      const bars = gsap.utils.toArray<HTMLElement>("[data-trace-tree-item]", rootEl);

      if (reduced) {
        gsap.set(bars, { scaleX: 1 });
        return;
      }

      gsap.set(bars, { scaleX: 0, transformOrigin: "left center" });
      gsap.to(bars, {
        scaleX: 1,
        duration: 0.45,
        ease: "power2.out",
        stagger: 0.12,
        scrollTrigger: { trigger: rootEl, start: "top 85%", once: true },
      });
    }, rootEl);
  }

  setup();
  document.addEventListener("astro:page-load", setup);
  document.addEventListener("astro:after-swap", () => ctx?.revert());
</script>

<style>
  .concept-demo {
    margin: 1.75rem 0 2rem;
    padding: 1.4rem 1.6rem;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--bg-raised);
  }

  .concept-demo-label {
    margin: 0 0 1.1rem;
    font-size: 0.68rem;
    letter-spacing: 0.06em;
    color: var(--accent-text, var(--accent));
  }

  .trace-tree-rows {
    display: flex;
    flex-direction: column;
    gap: 0.55rem;
    margin-bottom: 1.1rem;
  }

  .trace-tree-row {
    display: grid;
    grid-template-columns: 14rem 1fr 3.5rem;
    align-items: center;
    gap: 0.75rem;
    padding-left: calc(var(--depth, 0) * 1.4rem);
  }

  .trace-tree-label {
    font-size: 0.72rem;
    color: var(--text-secondary);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .trace-tree-track {
    position: relative;
    height: 18px;
    background: var(--bg-card);
    border-radius: 4px;
    border: 1px solid var(--border);
  }

  .trace-tree-bar {
    position: absolute;
    top: 0;
    height: 100%;
    border-radius: 3px;
    background: var(--accent);
  }

  .trace-tree-row[style*="--depth:1"] .trace-tree-bar {
    background: var(--text-secondary);
    opacity: 0.75;
  }

  .trace-tree-ms {
    font-size: 0.72rem;
    text-align: right;
    color: var(--text-secondary);
  }

  .trace-tree-total {
    margin: 0;
    padding-top: 0.8rem;
    border-top: 1px dashed var(--border);
    font-size: 0.78rem;
    color: var(--text-secondary);
  }

  @media (max-width: 640px) {
    .trace-tree-row {
      grid-template-columns: 8rem 1fr 3rem;
      gap: 0.5rem;
      padding-left: calc(var(--depth, 0) * 0.8rem);
    }

    .trace-tree-label {
      font-size: 0.66rem;
    }
  }
</style>
