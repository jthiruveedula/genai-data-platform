---
import { MODULES } from "../../data/modules";

interface Props {
  moduleId: string;
}

const { moduleId } = Astro.props;
const base = import.meta.env.BASE_URL;

const mod = MODULES.find((m) => m.id === moduleId);
if (!mod) throw new Error(`ModuleHero: unknown module id "${moduleId}"`);

const LANE_LABEL: Record<string, string> = {
  beginner: "CORE",
  intermediate: "DEEPEN",
  advanced: "SCALE",
};

/** Same 3 lanes as the act-filter on the homepage's Curriculum section
 *  (redesign phase 5, issue #151) — a second derived label off the same
 *  `path` field, no new data. Turns "12 independent lessons" into "one
 *  operating manual with three parts," visible on every module page. */
const ACT_LABEL: Record<string, string> = {
  beginner: "Foundations",
  intermediate: "Runtime & governance",
  advanced: "Operations & scale",
};

const orderLabel = String(mod.order).padStart(2, "0");
---

<div class="reading-progress" data-reading-progress aria-hidden="true">
  <span class="reading-progress-fill" data-reading-progress-fill></span>
</div>

<header class="module-hero">
  <nav class="breadcrumb" aria-label="Breadcrumb">
    <a href={`${base}#curriculum`}>Curriculum</a>
    <span class="crumb-sep" aria-hidden="true">/</span>
    <span class="crumb-current">Module {orderLabel}</span>
  </nav>

  <div class="hero-meta">
    <span class="chip chip--accent">{LANE_LABEL[mod.path]}</span>
    <span class="chip">{ACT_LABEL[mod.path]}</span>
    <span class="chip mono">MODULE {orderLabel}</span>
    <span class="chip mono">~{mod.estimatedMinutes} MIN</span>
  </div>

  <h1 class="module-title">{mod.title}</h1>

  <div class="module-intro">
    <slot />
  </div>
</header>

<script>
  // Reading-progress bar: fill width tracks how far through <article> the
  // reader has scrolled (0% at its top edge entering view, 100% once its
  // bottom edge has passed the viewport bottom) — module pages are the
  // site's long-form reading surface, this replaces "how much is left" with
  // a glance instead of a guess. rAF-throttled scroll listener, no library.
  function setup() {
    const fill = document.querySelector<HTMLElement>("[data-reading-progress-fill]");
    const article = document.querySelector("article");
    if (!fill || !article) return;
    if (fill.dataset.bound === "true") return;
    fill.dataset.bound = "true";

    let ticking = false;
    function update() {
      ticking = false;
      const rect = article!.getBoundingClientRect();
      const total = rect.height - window.innerHeight;
      const traveled = -rect.top;
      const pct = total > 0 ? Math.min(100, Math.max(0, (traveled / total) * 100)) : 0;
      fill!.style.width = `${pct}%`;
    }
    function onScroll() {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(update);
    }
    update();
    window.addEventListener("scroll", onScroll, { passive: true });
    window.addEventListener("resize", onScroll);
  }

  setup();
  document.addEventListener("astro:page-load", setup);
</script>

<style>
  .reading-progress {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    height: 2px;
    z-index: 60;
    background: transparent;
    pointer-events: none;
  }

  .reading-progress-fill {
    display: block;
    height: 100%;
    width: 0%;
    background: linear-gradient(90deg, var(--accent), var(--accent-2, var(--accent)));
    transition: width var(--duration-micro, 120ms) linear;
  }

  @media (prefers-reduced-motion: reduce) {
    .reading-progress-fill {
      transition: none;
    }
  }

  .module-hero {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.85rem;
    padding-bottom: 1.75rem;
    margin-bottom: 1.75rem;
    border-bottom: 1px solid var(--border);
    /* Contains the ::before glow's horizontal bleed below — without this,
       its negative left/right inset pushes past the box edge and forces
       page-level horizontal overflow (caught by the 320-768px sweep). */
    overflow: hidden;
  }

  /* Quiet ambient glow behind the hero title — same accent-reading contained
     radial the homepage/module-flow diagrams use, kept local to this box
     (not fixed/global like the site-wide atmosphere layer) so it reads as
     "this module's" identity, not a page-wide effect. */
  .module-hero::before {
    content: "";
    position: absolute;
    inset: -20% -10% auto -10%;
    height: 14rem;
    background: radial-gradient(closest-side, color-mix(in srgb, var(--accent) 10%, transparent), transparent 72%);
    pointer-events: none;
    z-index: -1;
  }

  .breadcrumb {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--text-secondary);
  }

  .breadcrumb a {
    color: var(--text-secondary);
    text-decoration: none;
  }

  .breadcrumb a:hover {
    color: var(--accent-text, var(--accent));
    text-decoration: underline;
  }

  .crumb-sep {
    color: var(--border);
  }

  .crumb-current {
    color: var(--text);
  }

  .hero-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .module-title {
    margin: 0;
    font-size: clamp(1.9rem, 4vw, 2.6rem);
    font-weight: 800;
    letter-spacing: -0.02em;
  }

  .module-intro :global(p) {
    margin: 0;
    max-width: 44rem;
    color: var(--text-secondary);
    line-height: 1.6;
    font-size: 1.05rem;
  }

  .module-intro :global(p + p) {
    margin-top: 0.75rem;
  }
</style>
