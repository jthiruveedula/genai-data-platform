---
import { LIFECYCLE, AGENT_LOOP_STAGES } from "../../data/platform";
import { CLOUDS, MODULES } from "../../data/modules";

const base = import.meta.env.BASE_URL;

const stageById = new Map([...LIFECYCLE, ...AGENT_LOOP_STAGES].map((s) => [s.id, s]));

/**
 * HTML service labels absolutely positioned over the SVG schematic.
 * Percentages are relative to the 640x700 viewBox (extended from 640x560 in
 * redesign phase 1, issue #147, to append the agent-loop row below the
 * original RAG pipeline) so they track the responsive stage (the wrapper
 * keeps a fixed 640/700 aspect ratio).
 */
const SERVICE_OVERLAYS = [
  // Top/mid-row labels: original px positions (unchanged — same node
  // coordinates as before) re-expressed as a % of the new 860px-tall
  // viewBox instead of the old 560px one. The agent-loop row needed a
  // bigger gap below RETRIEVE/LLM/ANSWER than the first attempt gave it —
  // those captions can wrap to 2-3 lines (e.g. "Vector Search hybrid
  // (dense + sparse)"), which overlapped the new row and the "REPEATS"
  // annotation below it at smaller total heights. 860px restores a real
  // gap on both sides, verified in-browser at 375px width.
  { id: "ingest", left: "37.5%", top: "13.3%" },
  { id: "chunk", left: "61.7%", top: "13.3%" },
  { id: "embed", left: "85.5%", top: "13.3%" },
  { id: "index", left: "50%", top: "39.4%" },
  { id: "retrieve", left: "20.3%", top: "55.6%" },
  { id: "llm", left: "50%", top: "55.6%" },
  { id: "plan", left: "17.2%", top: "80%" },
  { id: "act", left: "50%", top: "80%" },
  { id: "observe", left: "82.8%", top: "80%" },
].map((pos) => {
  const stage = stageById.get(pos.id);
  if (!stage) throw new Error(`HeroScene: unknown lifecycle stage "${pos.id}"`);
  return { ...pos, stage };
});
---

<section class="hero" data-hero-scene aria-labelledby="hero-heading">
  <div class="hero-content">
    <div class="kicker-row" data-rise>
      <span class="chip chip--accent">MULTI-CLOUD CURRICULUM</span>
      <span class="chip mono" data-hero-ticker aria-live="off">0 TOKENS · $0.0000</span>
    </div>

    <h1 id="hero-heading" class="hero-title">
      <span class="h1-mask"><span class="h1-line">Engineer the <span class="hl">agents</span> your</span></span>
      <span class="h1-mask"><span class="h1-line">enterprise can trust in production.</span></span>
    </h1>

    {
      /* No data-rise here: this paragraph is the page's LCP candidate (largest
         rendered text block above the fold). Gating it behind the entrance
         timeline's fade-in pushed LCP past 2.5s in Lighthouse — a real cost
         for a purely decorative flourish, not one of the pipeline-demonstrating
         scenes this project's own motion budget reserves large animation for. */
    }
    <p class="lede">Starts where RAG ends. Watch the pipeline become an agent runtime, live, on your cloud.</p>

    <div class="cta-row" data-rise>
      <a class="btn btn-primary" href={`${base}modules/00-foundations/`} data-primary-cta data-base={base}>
        <span data-primary-cta-label>Start with Foundations</span>
        <svg width="14" height="14" viewBox="0 0 16 16" fill="none" aria-hidden="true">
          <path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path>
        </svg>
      </a>
      <a class="btn btn-ghost" href={`${base}#architecture`}>See the architecture</a>
    </div>

    <div class="switch-block" data-rise>
      <div class="switcher glass-panel" role="group" aria-label="Choose your cloud platform">
        {
          CLOUDS.map((c) => (
            <button type="button" class="switch-btn" data-cloud-btn={c.id} aria-pressed="false">
              <img src={`${base}logos/${c.id}.svg`} width="22" height="22" alt="" />
              <span class="switch-label">{c.label}</span>
              <span class="switch-tagline">{c.tagline}</span>
            </button>
          ))
        }
      </div>
      <p class="switch-caption">Click one — the diagram re-maps live.</p>
    </div>
  </div>

  <div class="hero-canvas" aria-hidden="true">
    <div class="hero-glow" data-hero-glow></div>
    <div class="canvas-stage" data-canvas-stage>
      <svg viewBox="0 0 640 860" fill="none" xmlns="http://www.w3.org/2000/svg">
        <defs>
          <pattern id="hs-grid" width="40" height="40" patternUnits="userSpaceOnUse">
            <path d="M40 0H0V40" fill="none" stroke="var(--border)" stroke-opacity="0.35" stroke-width="1"></path>
          </pattern>
          <radialGradient id="hs-glow-grad">
            <stop offset="0" stop-color="var(--accent)" stop-opacity="0.12"></stop>
            <stop offset="1" stop-color="var(--accent)" stop-opacity="0"></stop>
          </radialGradient>
          <linearGradient id="hs-scan-grad" x1="0" y1="0" x2="0" y2="1">
            <stop offset="0" stop-color="var(--accent)" stop-opacity="0"></stop>
            <stop offset="0.5" stop-color="var(--accent)" stop-opacity="0.1"></stop>
            <stop offset="1" stop-color="var(--accent)" stop-opacity="0"></stop>
          </linearGradient>
          <marker id="hs-repeat-arrow" markerWidth="7" markerHeight="7" refX="3.2" refY="3.5" orient="auto">
            <path d="M0,0 L7,3.5 L0,7 Z" fill="var(--text-secondary)"></path>
          </marker>
        </defs>

        <!-- Background: grid + soft accent glow -->
        <rect x="0" y="0" width="640" height="860" fill="url(#hs-grid)" opacity="0.5"></rect>
        <ellipse cx="320" cy="280" rx="260" ry="200" fill="url(#hs-glow-grad)"></ellipse>

        <!-- Flow overlays (dashed accent, packets ride these; drawn under nodes) -->
        <path id="hs-flow-a" class="hs-flow" d="M28 90 H552 C552 180 500 240 414 262" stroke="var(--accent)" stroke-opacity="0.35" stroke-width="1" stroke-dasharray="6 10"></path>
        <path id="hs-flow-b" class="hs-flow" d="M230 300 C160 320 130 370 130 426" stroke="var(--accent)" stroke-opacity="0.35" stroke-width="1" stroke-dasharray="6 10"></path>
        <path id="hs-flow-c" class="hs-flow" d="M68 450 H572" stroke="var(--accent)" stroke-opacity="0.35" stroke-width="1" stroke-dasharray="6 10"></path>

        <!-- Base connectors (drawn on entrance) -->
        <path class="hs-draw" d="M150 90 H175" stroke="var(--border)" stroke-width="1"></path>
        <path class="hs-draw" d="M305 90 H330" stroke="var(--border)" stroke-width="1"></path>
        <path class="hs-draw" d="M460 90 H485" stroke="var(--border)" stroke-width="1"></path>
        <path class="hs-draw" d="M552 110 C552 180 500 240 414 262" stroke="var(--border)" stroke-width="1"></path>
        <path class="hs-draw" d="M230 300 C160 320 130 370 130 426" stroke="var(--border)" stroke-width="1"></path>
        <path class="hs-draw" d="M200 450 H260" stroke="var(--border)" stroke-width="1"></path>
        <path class="hs-draw" d="M380 450 H440" stroke="var(--border)" stroke-width="1"></path>

        <!-- Pipeline nodes: top row -->
        <g class="hs-node" data-node="sources">
          <rect x="20" y="70" width="130" height="40" rx="6" fill="var(--bg-card)" stroke="var(--border)"></rect>
          <text class="hs-label" x="85" y="94" text-anchor="middle">SOURCES</text>
        </g>
        <g class="hs-node" data-node="ingest">
          <rect x="175" y="70" width="130" height="40" rx="6" fill="var(--bg-card)" stroke="var(--border)"></rect>
          <text class="hs-label" x="240" y="94" text-anchor="middle">INGEST</text>
        </g>
        <g class="hs-node" data-node="chunk">
          <rect x="330" y="70" width="130" height="40" rx="6" fill="var(--bg-card)" stroke="var(--border)"></rect>
          <text class="hs-label" x="395" y="94" text-anchor="middle">CHUNK</text>
        </g>
        <g class="hs-node" data-node="embed">
          <rect x="485" y="70" width="135" height="40" rx="6" fill="var(--bg-card)" stroke="var(--border)"></rect>
          <text class="hs-label" x="552" y="94" text-anchor="middle">EMBED</text>
        </g>

        <!-- Center: vector DB with concentric ring detail -->
        <g class="hs-node" data-node="index">
          <rect x="230" y="225" width="180" height="105" rx="8" fill="var(--bg-card)" stroke="var(--border)"></rect>
          <text class="hs-label" x="320" y="248" text-anchor="middle">VECTOR DB</text>
          <circle class="hs-ring" cx="320" cy="290" r="14" stroke="var(--accent)" stroke-opacity="0.5"></circle>
          <circle class="hs-ring" cx="320" cy="290" r="24" stroke="var(--accent)" stroke-opacity="0.3" stroke-dasharray="3 5"></circle>
          <circle class="hs-ring" cx="320" cy="290" r="33" stroke="var(--border)" stroke-dasharray="2 6"></circle>
          <circle class="hs-core" cx="320" cy="290" r="3.5" fill="var(--accent)"></circle>
        </g>

        <!-- Bottom row -->
        <g class="hs-node" data-node="retrieve">
          <rect x="60" y="430" width="140" height="40" rx="6" fill="var(--bg-card)" stroke="var(--border)"></rect>
          <text class="hs-label" x="130" y="454" text-anchor="middle">RETRIEVE</text>
        </g>
        <g class="hs-node" data-node="llm">
          <rect x="260" y="430" width="120" height="40" rx="6" fill="var(--bg-card)" stroke="var(--border)"></rect>
          <text class="hs-label" x="320" y="454" text-anchor="middle">LLM</text>
        </g>
        <g class="hs-node" data-node="answer">
          <rect x="440" y="430" width="140" height="40" rx="6" fill="var(--bg-card)" stroke="var(--border)"></rect>
          <text class="hs-label" x="510" y="454" text-anchor="middle">ANSWER</text>
        </g>

        <!-- Agent-loop extension (redesign phase 1, issue #147): the RAG
             pipeline above becomes an agent loop once tool use enters the
             picture. New .hs-draw connectors below join the existing 7 and
             pick up their stroke length via getTotalLength() automatically
             (see the script's WIRE_LENGTHS fallback) — no hardcoding needed
             for these three. New .hs-node elements are picked up by the
             existing entrance-timeline stagger the same way. -->
        <path class="hs-draw" d="M510 470 C510 560 300 560 110 635" stroke="var(--border)" stroke-width="1"></path>
        <path class="hs-draw" d="M200 660 H230" stroke="var(--border)" stroke-width="1"></path>
        <path class="hs-draw" d="M410 660 H440" stroke="var(--border)" stroke-width="1"></path>

        <g class="hs-node" data-node="plan">
          <rect x="20" y="640" width="180" height="40" rx="6" fill="var(--bg-card)" stroke="var(--border)"></rect>
          <text class="hs-label" x="110" y="664" text-anchor="middle">PLAN</text>
        </g>
        <g class="hs-node" data-node="act">
          <rect x="230" y="640" width="180" height="40" rx="6" fill="var(--bg-card)" stroke="var(--border)"></rect>
          <text class="hs-label" x="320" y="664" text-anchor="middle">TOOL CALL</text>
        </g>
        <g class="hs-node" data-node="observe">
          <rect x="440" y="640" width="180" height="40" rx="6" fill="var(--bg-card)" stroke="var(--border)"></rect>
          <text class="hs-label" x="530" y="664" text-anchor="middle">OBSERVE</text>
        </g>

        <!-- Static (non-animated) repeat arrow: the loop is capped by an
             iteration budget, not literally infinite, so this is a fixed
             annotation rather than an ambient looping packet. -->
        <path
          d="M530 680 C530 730 110 730 110 680"
          fill="none"
          stroke="var(--text-secondary)"
          stroke-width="1"
          stroke-dasharray="3 5"
          opacity="0.6"
          marker-end="url(#hs-repeat-arrow)"
        ></path>
        <text class="hs-hud" x="320" y="812" text-anchor="middle">REPEATS · CAPPED ITERATION BUDGET</text>

        <!-- Packets (revealed + driven by GSAP MotionPath) -->
        <circle class="hs-packet" r="3" fill="var(--accent)" opacity="0"></circle>
        <circle class="hs-packet" r="3" fill="var(--accent)" opacity="0"></circle>
        <circle class="hs-packet" r="3" fill="var(--accent)" opacity="0"></circle>

        <!-- One-shot guided document: on first load, this rides flow-a → b → c
             in sequence (the same three routes the ambient packets loop on
             independently) so a first-time visitor watches one real document
             travel the whole pipeline once, instead of only ever seeing
             already-in-flight ambient dots. Same folded-document shape as the
             Architecture Story's HUD token, for visual continuity. -->
        <g class="hs-hero-doc" data-hs-hero-doc opacity="0">
          <circle class="hero-doc-halo" r="20" fill="var(--accent)" opacity="0.18"></circle>
          <path d="M-16 -18 L7 -18 L16 -9 L16 18 L-16 18 Z" fill="var(--bg-raised)" stroke="var(--accent)" stroke-width="1.4" stroke-linejoin="round"></path>
          <path d="M7 -18 L7 -9 L16 -9 Z" fill="var(--accent)" opacity="0.55"></path>
          <line x1="-9" y1="-3" x2="10" y2="-3" stroke="var(--text-secondary)" stroke-width="1.6" stroke-linecap="round"></line>
          <line x1="-9" y1="3" x2="5" y2="3" stroke="var(--text-secondary)" stroke-width="1.6" stroke-linecap="round"></line>
          <line x1="-9" y1="9" x2="2" y2="9" stroke="var(--accent)" stroke-width="1.6" stroke-linecap="round" class="hero-doc-citation" opacity="0"></line>
        </g>

        <!-- Scanline (parked above the viewBox; GSAP sweeps it) -->
        <rect class="hs-scan" x="0" y="-44" width="640" height="36" fill="url(#hs-scan-grad)"></rect>

        <!-- HUD dressing -->
        <g stroke="var(--border)" stroke-width="1.5" fill="none">
          <path d="M8 22V8h14"></path>
          <path d="M618 8h14v14"></path>
          <path d="M632 838v14h-14"></path>
          <path d="M22 852H8v-14"></path>
        </g>
        <text class="hs-hud" x="596" y="26" text-anchor="end">PIPELINE // LIVE</text>
        <circle cx="608" cy="22.5" r="3" fill="var(--accent)"></circle>
      </svg>

      {
        SERVICE_OVERLAYS.map((o) => (
          <div class="node-service" style={`left:${o.left};top:${o.top};`}>
            <span class="cloud-swap">
              <span data-for="neutral">{o.stage.services.neutral}</span>
              <span data-for="gcp">{o.stage.services.gcp}</span>
              <span data-for="aws">{o.stage.services.aws}</span>
              <span data-for="azure">{o.stage.services.azure}</span>
              <span data-for="oss">{o.stage.services.oss}</span>
            </span>
          </div>
        ))
      }
    </div>
  </div>

  <div class="scroll-cue" data-scroll-cue aria-hidden="true">
    <span>SCROLL</span>
    <span class="cue-line"></span>
  </div>
</section>

<script>
  import { gsap } from "gsap";
  import { MotionPathPlugin } from "gsap/MotionPathPlugin";
  import { MODULES } from "../../data/modules";
  import { nextIncompleteModule } from "../../lib/progress";

  gsap.registerPlugin(MotionPathPlugin);

  const TOKENS_TARGET = 2483;
  const COST_PER_TOKEN = 0.0000027;

  function tickerText(tokens: number): string {
    return `${Math.round(tokens).toLocaleString()} TOKENS · $${(tokens * COST_PER_TOKEN).toFixed(4)}`;
  }

  const ORDERED_MODULES = [...MODULES].sort((a, b) => a.order - b.order);

  // Plain DOM/text swap, not a tween — kept out of the GSAP context below so
  // it isn't reverted/reapplied on every ClientRouter navigation, and reads
  // localStorage fresh each time (a full navigation back from a module page
  // is what re-fires astro:page-load, the same refresh point CurriculumJourney
  // relies on for its own progress badges).
  function renderResumeCta() {
    const link = document.querySelector<HTMLAnchorElement>("[data-primary-cta]");
    const label = document.querySelector<HTMLElement>("[data-primary-cta-label]");
    if (!link || !label || !ORDERED_MODULES.length) return;

    // Read from data-base (set once from Astro's import.meta.env.BASE_URL),
    // not by parsing link.href — href gets rewritten by this same function,
    // so a second call would otherwise be parsing its own prior output.
    const base = link.dataset.base ?? "/";
    const next = nextIncompleteModule(ORDERED_MODULES.map((m) => m.id));

    if (next === null) {
      // Every module's recap has been seen — nothing left to "start" or "resume".
      link.href = `${base}#curriculum`;
      label.textContent = "Review the curriculum";
    } else if (next === ORDERED_MODULES[0].id) {
      // No progress yet — the default first-visit state, already in the markup.
      link.href = `${base}modules/${next}/`;
      label.textContent = "Start with Foundations";
    } else {
      const mod = ORDERED_MODULES.find((m) => m.id === next)!;
      link.href = `${base}modules/${next}/`;
      label.textContent = `Resume: ${mod.title}`;
    }
  }

  let ctx: gsap.Context | undefined;

  function setup() {
    const rootEl = document.querySelector<HTMLElement>("[data-hero-scene]");
    if (!rootEl) return;
    ctx?.revert();
    ctx = gsap.context((self) => {
      const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
      const cleanups: Array<() => void> = [];

      // Schedules non-critical setup (infinite ambient loops, pointer
      // parallax — nothing the visitor needs for first paint or the guided
      // entrance) off the initial task, instead of adding straight to it.
      // `self.add()` keeps whatever GSAP animations `fn` creates tracked by
      // this context, even though `fn` itself runs later, async — so
      // `ctx.revert()` on cleanup still reverts them correctly.
      const deferIdle = (fn: () => void) => {
        if (typeof window.requestIdleCallback === "function") {
          window.requestIdleCallback(() => self.add(fn), { timeout: 1000 });
        } else {
          setTimeout(() => self.add(fn), 200);
        }
      };

      const ticker = rootEl.querySelector<HTMLElement>("[data-hero-ticker]");
      const stage = rootEl.querySelector<HTMLElement>("[data-canvas-stage]");
      const glow = rootEl.querySelector<HTMLElement>("[data-hero-glow]");
      const cue = rootEl.querySelector<HTMLElement>("[data-scroll-cue]");
      const dbNode = rootEl.querySelector<SVGGElement>('[data-node="index"]');
      const services = gsap.utils.toArray<HTMLElement>(".node-service", rootEl);
      const wires = gsap.utils.toArray<SVGPathElement>(".hs-draw", rootEl);
      const flows = gsap.utils.toArray<SVGPathElement>(".hs-flow", rootEl);
      const packets = gsap.utils.toArray<SVGCircleElement>(".hs-packet", rootEl);
      const nodes = gsap.utils.toArray<SVGGElement>(".hs-node", rootEl);

      // Scroll cue fades once the visitor scrolls (both motion modes;
      // reduced motion snaps instead of tweening).
      if (cue) {
        let hidden = false;
        const onScroll = () => {
          const shouldHide = window.scrollY > 60;
          if (shouldHide === hidden) return;
          hidden = shouldHide;
          if (reduced) {
            gsap.set(cue, { autoAlpha: shouldHide ? 0 : 1 });
          } else {
            gsap.to(cue, { autoAlpha: shouldHide ? 0 : 1, duration: 0.3, ease: "power2.out", overwrite: "auto" });
          }
        };
        window.addEventListener("scroll", onScroll, { passive: true });
        cleanups.push(() => window.removeEventListener("scroll", onScroll));
      }

      if (reduced) {
        // Complete static final state: everything is already visible in the
        // markup (packets/scanline are parked invisible), so only the ticker
        // needs its settled value. No loops, no entrance.
        if (ticker) ticker.textContent = tickerText(TOKENS_TARGET);
        return () => cleanups.forEach((fn) => fn());
      }

      // ---- 1. Entrance -------------------------------------------------
      gsap.set(flows, { autoAlpha: 0 });
      // Precomputed getTotalLength() for the 7 static ".hs-draw" wires
      // above, in document order — their `d` attributes are hardcoded and
      // never change, so measuring them at runtime only bought a forced
      // synchronous layout (part of this scene's above-the-fold
      // total-blocking-time cost, since it can't be deferred like the
      // below-fold sections) for a value that's always the same.
      const WIRE_LENGTHS = [25, 25, 25, 221.649, 174.085, 60, 60];
      const wireLengths = wires.map((p, i) => WIRE_LENGTHS[i] ?? p.getTotalLength());
      wires.forEach((p, i) => {
        gsap.set(p, { strokeDasharray: wireLengths[i], strokeDashoffset: wireLengths[i] });
      });

      // Brief accent flash on a node (and a matching stroke-color transition
      // already declared on `.hs-node rect`) — the visual beat that marks
      // "the document just arrived here" as the guided journey below passes
      // each stage.
      function flashNode(id: string) {
        const node = rootEl.querySelector<SVGGElement>(`[data-node="${id}"]`);
        if (!node) return;
        node.classList.add("is-arrived");
        gsap.fromTo(
          node,
          { scale: 1 },
          { scale: 1.05, transformOrigin: "50% 50%", duration: 0.18, ease: "power2.out", yoyo: true, repeat: 1 },
        );
        gsap.delayedCall(0.6, () => node.classList.remove("is-arrived"));
      }

      // ---- Boot-sequence: "the system powering on" ----------------------
      // A single staggered tween across all 11 nodes (one GSAP tween
      // instance, not 11). Two earlier versions of this (a per-node
      // scanner+pop timeline, then a single-pass scanner sweep) both read
      // fine locally but pushed real CI's total-blocking-time over its
      // 700ms budget (758ms, then 741ms) on its slower/throttled runner —
      // animating an SVG rect's `y`/geometry over a full second forces a
      // layout recalculation every frame, unlike a `transform`-only tween,
      // and that cost only showed up on CI's weaker hardware. Dropped the
      // scanner sweep entirely; the stagger pop + the dim -> bright CSS
      // transition (declared on `.hs-node rect`/`.hs-label`) still reads as
      // "powering on in sequence" without a per-frame layout cost.
      // `is-dim` is removed per node via a plain `delayedCall` (a scheduled
      // callback, not a tweened property).
      const BOOT_ORDER = ["sources", "ingest", "chunk", "embed", "index", "retrieve", "llm", "answer", "plan", "act", "observe"];
      const BOOT_STAGGER = 0.09;

      function bootSequence() {
        BOOT_ORDER.forEach((id, i) => {
          gsap.delayedCall(i * BOOT_STAGGER, () => {
            rootEl.querySelector<SVGGElement>(`[data-node="${id}"]`)?.classList.remove("is-dim");
          });
        });
        gsap.fromTo(
          nodes,
          { scale: 0.86 },
          {
            scale: 1,
            transformOrigin: "50% 50%",
            duration: 0.4,
            ease: "back.out(2.2)",
            stagger: BOOT_STAGGER,
          },
        );
      }

      const heroDoc = rootEl.querySelector<SVGGElement>("[data-hs-hero-doc]");
      const heroDocCitation = rootEl.querySelector<SVGLineElement>(".hero-doc-citation");
      const flowAEl = rootEl.querySelector<SVGPathElement>("#hs-flow-a");
      const flowBEl = rootEl.querySelector<SVGPathElement>("#hs-flow-b");
      const flowCEl = rootEl.querySelector<SVGPathElement>("#hs-flow-c");

      // Ticker's first count-up plays in lockstep with the guided document
      // below (paused here, `.play(0)` called from the entrance timeline at
      // the same position the document starts moving) — after that first
      // synced run it keeps its own independent repeat loop, same as before.
      const tickerCounter = { tokens: 0 };
      const tickerTl = ticker
        ? gsap.timeline({ paused: true, repeat: -1, repeatDelay: 2.4 }).fromTo(
            tickerCounter,
            { tokens: 0 },
            {
              tokens: TOKENS_TARGET,
              duration: 1.4,
              ease: "power1.out",
              onUpdate: () => {
                ticker.textContent = tickerText(tickerCounter.tokens);
              },
            },
          )
        : null;

      // Dim/grayscale resting state for every node until its own
      // materialize beat below — the "blueprint before power-on" read.
      nodes.forEach((n) => (n as SVGGElement).classList.add("is-dim"));
      gsap.set(nodes, { autoAlpha: 0, scale: 0.94, transformOrigin: "50% 50%" });

      const entrance = gsap.timeline({ defaults: { ease: "power3.out" } });
      entrance
        .from(rootEl.querySelectorAll(".h1-line"), { yPercent: 30, autoAlpha: 0, duration: 0.7, stagger: 0.08 })
        .from(
          rootEl.querySelectorAll("[data-rise]"),
          { y: 14, autoAlpha: 0, duration: 0.55, ease: "power2.out", stagger: 0.06 },
          "-=0.35",
        )
        .to(nodes, { autoAlpha: 1, duration: 0.3 }, "-=0.35")
        // Wires draw first — the circuit's shape appears before anything on
        // it powers on.
        .to(wires, { strokeDashoffset: 0, duration: 0.7, ease: "power2.inOut", stagger: 0.04 }, "-=0.1")
        // Multiple light pulses race the full circuit at once, right as
        // nodes begin powering on — reuses the same packet dots the ambient
        // loop uses later, so this costs zero extra DOM.
        .call(() => {
          const raceWires = wires.filter((_, i) => i % 2 === 0).slice(0, packets.length);
          packets.forEach((packet, i) => {
            const wire = raceWires[i];
            if (!wire) return;
            gsap.set(packet, { autoAlpha: 1 });
            gsap.to(packet, {
              motionPath: { path: wire, align: wire, alignOrigin: [0.5, 0.5] },
              duration: 0.9 + i * 0.15,
              ease: "power1.inOut",
              onComplete: () => gsap.set(packet, { autoAlpha: 0 }),
            });
          });
        })
        // Nodes power on in pipeline order — see bootSequence() above.
        .call(() => bootSequence(), undefined, "-=0.1")
        .to(flows, { autoAlpha: 1, duration: 0.6, ease: "power2.out" }, `+=${BOOT_ORDER.length * BOOT_STAGGER + 0.2}`)
        .to(packets, { autoAlpha: 1, duration: 0.4 }, "<");

      // ---- 1b. Guided first journey: one document, sources to answer ----
      // Rides the same three flow paths the ambient packets loop on forever,
      // but once, in order, right after the schematic finishes assembling —
      // "every animation demonstrates the concept next to it" applied to the
      // hero itself: a first-time visitor sees one real request complete
      // before anything repeats.
      if (heroDoc && flowAEl && flowBEl && flowCEl) {
        gsap.set(heroDoc, { x: 28, y: 90 });
        entrance
          .call(() => tickerTl?.play(0))
          .to(heroDoc, { autoAlpha: 1, duration: 0.001 })
          .to(heroDoc, {
            motionPath: { path: flowAEl, align: flowAEl, alignOrigin: [0.5, 0.5] },
            duration: 1.3,
            ease: "power1.inOut",
          })
          .call(() => flashNode("index"))
          .to(heroDoc, {
            motionPath: { path: flowBEl, align: flowBEl, alignOrigin: [0.5, 0.5] },
            duration: 0.7,
            ease: "power1.inOut",
          })
          .call(() => flashNode("retrieve"))
          .to(heroDoc, {
            motionPath: { path: flowCEl, align: flowCEl, alignOrigin: [0.5, 0.5] },
            duration: 1.0,
            ease: "power1.inOut",
          })
          .call(() => {
            flashNode("llm");
            flashNode("answer");
          })
          .to(heroDocCitation, { opacity: 1, duration: 0.3 }, "<")
          .to(heroDoc, { scale: 1.18, duration: 0.2, ease: "power2.out", yoyo: true, repeat: 1, transformOrigin: "50% 50%" }, "<")
          .to(heroDoc, { autoAlpha: 0, duration: 0.4 }, "+=0.5");
      } else {
        entrance.call(() => tickerTl?.play(0));
      }

      // ---- 1c. Switcher spotlight: a motion nudge instead of more copy ----
      // The caption used to spell out "the whole platform re-maps to your
      // stack" in a full sentence; a brief highlight sweep across the four
      // buttons shows "these are the control" without more reading, right
      // as the guided journey above finishes. Purely visual (a class toggle
      // matching the existing pressed-state style) — never touches
      // aria-pressed or the real selected cloud, so it can't desync from
      // whatever the visitor has actually chosen.
      const switchBtns = gsap.utils.toArray<HTMLElement>(".switch-btn", rootEl);
      if (switchBtns.length) {
        entrance.call(() => {
          const sweep = gsap.timeline();
          switchBtns.forEach((btn, i) => {
            sweep
              .call(() => btn.classList.add("is-spotlit"), undefined, i * 0.16)
              .call(() => btn.classList.remove("is-spotlit"), undefined, i * 0.16 + 0.45);
          });
        }, undefined, "-=0.3");
      }

      // ---- 2. Ambient loop (deferred: infinite background loops, nothing
      // the visitor needs before first paint or the guided entrance above)
      deferIdle(() => {
        const routes = [
          { selector: "#hs-flow-a", duration: 7, delay: 0.9 },
          { selector: "#hs-flow-b", duration: 4, delay: 2.2 },
          { selector: "#hs-flow-c", duration: 5.5, delay: 1.5 },
        ];
        packets.forEach((packet, i) => {
          const route = routes[i];
          const pathEl = route ? rootEl.querySelector<SVGPathElement>(route.selector) : null;
          if (!route || !pathEl) return;
          gsap.to(packet, {
            motionPath: { path: pathEl, align: pathEl, alignOrigin: [0.5, 0.5] },
            duration: route.duration,
            delay: route.delay,
            repeat: -1,
            ease: "none",
          });
        });

        // Dash period is 16px (6 + 10) — a multiple keeps the loop seamless.
        gsap.to(flows, { strokeDashoffset: "-=96", duration: 6, repeat: -1, ease: "none" });

        const scan = rootEl.querySelector<SVGRectElement>(".hs-scan");
        if (scan) {
          gsap.fromTo(
            scan,
            { y: 0 },
            { y: 860, duration: 3.4, repeat: -1, repeatDelay: 4.6, ease: "power1.inOut", delay: 1.4 },
          );
        }
      });

      // ---- 4. Pointer parallax (desktop only, deferred: not needed until
      // the visitor actually moves the pointer) ---------------------------
      deferIdle(() => {
        const desktop = window.matchMedia("(min-width: 768px)").matches;
        if (desktop && stage && glow) {
          const stageX = gsap.quickTo(stage, "x", { duration: 0.7, ease: "power3.out" });
          const stageY = gsap.quickTo(stage, "y", { duration: 0.7, ease: "power3.out" });
          const glowX = gsap.quickTo(glow, "x", { duration: 0.9, ease: "power3.out" });
          const glowY = gsap.quickTo(glow, "y", { duration: 0.9, ease: "power3.out" });
          const clamp = gsap.utils.clamp(-0.5, 0.5);
          const onMove = (e: PointerEvent) => {
            const r = rootEl.getBoundingClientRect();
            const nx = clamp((e.clientX - r.left) / r.width - 0.5);
            const ny = clamp((e.clientY - r.top) / r.height - 0.5);
            stageX(nx * 20); // max 10px either way
            stageY(ny * 20);
            glowX(nx * -20); // opposite direction for depth
            glowY(ny * -20);
          };
          rootEl.addEventListener("pointermove", onMove);
          cleanups.push(() => rootEl.removeEventListener("pointermove", onMove));
        }
      });

      // ---- 5. Cloud change pulse ----------------------------------------
      // Accent-stroked SVG recolors itself via CSS var + transition; this
      // only adds the "the schematic reacted" beat.
      const onCloudChange = () => {
        if (dbNode) {
          gsap.fromTo(
            dbNode,
            { scale: 1 },
            { scale: 1.04, transformOrigin: "50% 50%", duration: 0.18, ease: "power2.out", yoyo: true, repeat: 1 },
          );
        }
        if (services.length) {
          gsap.fromTo(services, { autoAlpha: 0.15 }, { autoAlpha: 1, duration: 0.35, ease: "power2.out", overwrite: "auto" });
        }
      };
      document.addEventListener("gdp:cloud-change", onCloudChange);
      cleanups.push(() => document.removeEventListener("gdp:cloud-change", onCloudChange));

      // ---- 6. Scroll cue loop --------------------------------------------
      const cueLine = rootEl.querySelector<HTMLElement>(".cue-line");
      if (cueLine) {
        gsap
          .timeline({ repeat: -1, repeatDelay: 0.35 })
          .fromTo(cueLine, { scaleY: 0, transformOrigin: "50% 0%" }, { scaleY: 1, duration: 0.6, ease: "power2.inOut" })
          .to(cueLine, { scaleY: 0, transformOrigin: "50% 100%", duration: 0.6, ease: "power2.inOut" }, "+=0.15");
      }

      return () => cleanups.forEach((fn) => fn());
    }, rootEl);
  }

  setup();
  renderResumeCta();
  document.addEventListener("astro:page-load", () => {
    setup();
    renderResumeCta();
  });
  document.addEventListener("astro:after-swap", () => ctx?.revert());
</script>

<style>
  .hero {
    position: relative;
    min-height: 100dvh;
    display: flex;
    align-items: center;
    /* Homepage <main> is full-bleed (see BaseLayout.astro's
       main.main--full-bleed) so every section supplies its own horizontal
       gutter — this one never did, leaving the H1 flush against the
       viewport's left edge at every breakpoint (confirmed: 0px from the
       edge, not a rendering artifact). */
    padding: 2.5rem clamp(1.5rem, 5vw, 3rem) 3.5rem;
    /* Clips the full-bleed 3D/glow layer to this section's own box instead
       of risking page-level horizontal overflow. */
    overflow: hidden;
  }

  /* ---- Content column (left-aligned), floating over the full-bleed
     canvas below. A translucent scrim was tuned for the old 3D scene's
     abstract wireframe shapes, where a bit of bleed-through still read
     fine; the flat SVG schematic behind it now has literal text labels
     (SOURCES/RETRIEVE/PLAN sit under this column), and any translucency
     showed as garbled half-legible text at the seam. Solid --bg-card,
     matching every other panel on the site (.glass-panel), removes that
     entirely instead of trying to tune an opacity/blur value against text
     it can never fully hide. ---- */
  .hero-content {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1.1rem;
    max-width: 30rem;
    padding: 1.75rem clamp(1.1rem, 3vw, 2rem);
    border-radius: var(--radius);
    background: var(--bg-card);
    box-shadow: var(--shadow-panel);
  }

  .kicker-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.6rem;
  }

  .kicker-row .chip {
    font-size: 0.68rem;
  }

  [data-hero-ticker] {
    font-variant-numeric: tabular-nums;
  }

  .hero-title {
    margin: 0;
    font-family: var(--font-heading);
    font-weight: 700;
    /* Was clamp(2.6rem, 7vw, 5.25rem) — four lines at that size pushed the
       headline block past 700px tall, dominating the fold and crowding the
       schematic it's supposed to introduce. Compact by design now: the
       animation is the payoff, the headline is the setup. */
    font-size: clamp(2.1rem, 4.4vw, 3.6rem);
    letter-spacing: -0.03em;
    line-height: 1.05;
    color: var(--text);
  }

  .h1-mask {
    display: block;
    overflow: hidden;
    padding-block: 0.04em;
  }

  .h1-line {
    display: block;
  }

  .hl {
    position: relative;
    white-space: nowrap;
  }

  .hl::after {
    content: "";
    position: absolute;
    left: 0.02em;
    right: 0.02em;
    bottom: 0.03em;
    height: 0.09em;
    border-radius: 2px;
    background: var(--accent);
    opacity: 0.6;
    box-shadow: 0 2px 14px color-mix(in srgb, var(--accent) 45%, transparent);
    transition: background var(--duration-theme) var(--ease-out);
  }

  .lede {
    margin: 0;
    max-width: 34rem;
    color: var(--text-secondary);
    line-height: 1.6;
  }

  /* ---- CTAs ---- */
  .cta-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.8rem;
  }

  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    min-height: 44px;
    padding: 0.8rem 1.4rem;
    border-radius: var(--radius);
    font-weight: 600;
    font-size: 0.95rem;
    text-decoration: none;
    transition:
      transform var(--duration-micro) var(--ease-out),
      box-shadow var(--duration-micro) var(--ease-out),
      border-color var(--duration-micro) var(--ease-out),
      background var(--duration-theme) var(--ease-out);
  }

  .btn-primary {
    /* --accent-strong/--accent-contrast (base.css) default to --accent and
       near-black, which clears 4.5:1 for aws/gcp/oss/neutral; azure
       overrides both since its accent needs different handling (see
       azure.css) — using --bg-deep here previously failed WCAG contrast
       across every cloud in light mode (as low as 1.87:1) and in azure's
       dark mode too. */
    background: var(--accent-strong, var(--accent));
    color: var(--accent-contrast, var(--bg-deep));
  }

  .btn-primary:hover,
  .btn-primary:focus-visible {
    transform: translateY(-2px);
    box-shadow: 0 10px 30px color-mix(in srgb, var(--accent) 35%, transparent);
  }

  .btn-ghost {
    border: 1px solid var(--border);
    color: var(--text);
    background: transparent;
  }

  .btn-ghost:hover,
  .btn-ghost:focus-visible {
    transform: translateY(-2px);
    border-color: var(--accent);
  }

  /* ---- Cloud switcher ---- */
  .switch-block {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    width: 100%;
    max-width: 34rem;
  }

  .switcher {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 0.35rem;
    padding: 0.4rem;
  }

  .switch-btn {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.2rem;
    min-height: 44px;
    padding: 0.6rem 0.7rem;
    background: transparent;
    border: 0;
    border-radius: calc(var(--radius) - 4px);
    color: var(--text);
    text-align: left;
    cursor: pointer;
    transition:
      background var(--duration-micro) var(--ease-out),
      box-shadow var(--duration-micro) var(--ease-out);
  }

  .switch-btn:hover,
  .switch-btn:focus-visible {
    background: var(--bg-raised);
  }

  .switch-btn[aria-pressed="true"] {
    background: var(--bg-raised);
    box-shadow: inset 0 0 0 1.5px var(--accent);
  }

  .switch-btn.is-spotlit {
    background: var(--bg-raised);
    box-shadow:
      inset 0 0 0 1.5px var(--accent),
      0 0 16px color-mix(in srgb, var(--accent) 45%, transparent);
  }

  .switch-label {
    font-weight: 600;
    font-size: 0.85rem;
  }

  .switch-tagline {
    font-family: var(--font-mono);
    font-size: 0.6rem;
    letter-spacing: 0.02em;
    color: var(--text-secondary);
  }

  .switch-caption {
    margin: 0;
    font-family: var(--font-mono);
    font-size: 0.68rem;
    color: var(--text-secondary);
  }

  /* ---- Concepts row ---- */
  .concepts {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 0.7rem;
    margin-top: 0.4rem;
  }

  .concepts-label {
    font-family: var(--font-mono);
    font-size: 0.65rem;
    letter-spacing: 0.12em;
    color: var(--text-secondary);
  }

  .concepts-list {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.45rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .concepts-list li {
    display: flex;
    align-items: center;
    gap: 0.45rem;
  }

  .concepts-list li:not(:first-child)::before {
    content: "·";
    color: var(--border);
  }

  .concepts-list .chip {
    font-size: 0.6rem;
  }

  /* ---- Full-bleed background layer: the animated SVG schematic (GSAP
     boot sequence + guided document + ambient packets). Sits behind
     .hero-content via z-index, covers the entire hero section rather than
     sharing a grid column with it. ---- */
  .hero-canvas {
    position: absolute;
    inset: 0;
    z-index: 0;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .hero-glow {
    position: absolute;
    inset: 10% 6%;
    background: radial-gradient(closest-side, color-mix(in srgb, var(--accent) 16%, transparent), transparent 72%);
    pointer-events: none;
  }

  .canvas-stage {
    position: relative;
    width: 100%;
    max-width: 660px;
    aspect-ratio: 640 / 860;
  }

  .canvas-stage svg {
    display: block;
    width: 100%;
    height: 100%;
  }

  .hs-label {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.08em;
    fill: var(--text-secondary);
    transition: fill-opacity var(--duration-theme) var(--ease-out);
  }

  .hs-hud {
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.14em;
    fill: var(--text-secondary);
  }

  /* Accent-stroked pieces recolor smoothly on cloud change. */
  .hs-flow,
  .hs-ring {
    transition: stroke var(--duration-theme) var(--ease-out);
  }

  .hs-packet,
  .hs-core {
    transition: fill var(--duration-theme) var(--ease-out);
  }

  .hs-node rect {
    transition:
      fill var(--duration-theme) var(--ease-out),
      stroke var(--duration-theme) var(--ease-out),
      fill-opacity var(--duration-scene) var(--ease-out),
      stroke-opacity var(--duration-scene) var(--ease-out);
  }

  .hs-node.is-arrived rect {
    stroke: var(--accent);
  }

  /* Boot-sequence resting state: a dim, desaturated "blueprint" look before
     a node's own materialize beat brightens it — transitions on `rect` are
     already declared above, this only adds the values to transition to/from. */
  .hs-node.is-dim rect {
    fill-opacity: 0.55;
    stroke-opacity: 0.5;
  }

  .hs-node.is-dim .hs-label {
    fill-opacity: 0.45;
  }

  .hs-hero-doc .hero-doc-citation {
    transition: stroke var(--duration-theme) var(--ease-out);
  }

  .node-service {
    position: absolute;
    transform: translateX(-50%);
    width: max-content;
    /* The top-row nodes (SOURCES/INGEST/CHUNK/EMBED) sit ~24-25% of the
       stage width apart center-to-center (see SERVICE_OVERLAYS above) — at
       24% max-width, two adjacent captions' boxes touch with zero margin,
       so any cloud whose service name runs long (several do — e.g. OSS's
       "BGE via TEI (Text Embeddings Inference)" for EMBED) visibly crowds
       or overlaps into the neighboring node's space. 19% leaves a real gap
       regardless of which cloud's (longer) label is showing. */
    max-width: 19%;
    text-align: center;
    font-family: var(--font-mono);
    font-size: 0.6rem;
    line-height: 1.35;
    /* Quiet secondary detail, not a second layer of shouting accent text —
       9 of these render simultaneously, and at full --accent-text color
       they competed with the diagram's own structure for attention instead
       of reading as "more info if you want it." */
    color: var(--text-secondary);
    opacity: 0.75;
    pointer-events: none;
  }

  /* ---- Scroll cue ---- */
  .scroll-cue {
    position: absolute;
    left: 0;
    bottom: 0.75rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.4rem;
    font-family: var(--font-mono);
    font-size: 0.6rem;
    letter-spacing: 0.18em;
    color: var(--text-secondary);
  }

  .cue-line {
    display: block;
    width: 1px;
    height: 24px;
    background: var(--accent);
  }

  /* ---- Mobile: single column, canvas becomes a shorter backdrop band ---- */
  @media (max-width: 767px) {
    .hero {
      align-items: center;
      padding-bottom: 4.5rem;
    }

    .hero-content {
      max-width: 100%;
    }

    /* 860/640 aspect on a <=22.9rem-wide stage keeps height <= ~492px. */
    .canvas-stage {
      width: min(100%, 22.9rem);
    }

    .switcher {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>
