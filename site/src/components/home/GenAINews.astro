---
/**
 * Live GenAI news strip. No backend, no cron, no API key: the visitor's own
 * browser calls the Hacker News Algolia search API (CORS-open, keyless,
 * already ranks by recency) for stories matching GenAI topics, and renders
 * the extractive fields it returns as-is (title, source domain, points,
 * age) — no LLM summarization step. sessionStorage caches the result for
 * 15 minutes so navigating back to "/" mid-session doesn't refetch.
 */
---

<section class="pf-news" data-pf-news aria-labelledby="news-h2">
  <div class="pf-kicker">LIVE FROM THE FIELD</div>
  <h2 id="news-h2" class="pf-news__h2">What's shipping in GenAI right now.</h2>
  <p class="pf-news__body">
    The latest GenAI application and use-case discussion from Hacker News, fetched live in your
    browser — not curated, not summarized by us.
  </p>
  <ul class="pf-news__list" data-pf-news-list aria-live="polite">
    <li class="pf-news__empty" data-pf-news-status>Loading latest stories…</li>
  </ul>
</section>

<script>
  interface Hit {
    objectID: string;
    title: string | null;
    url: string | null;
    points: number | null;
    created_at: number;
  }

  const CACHE_KEY = "gdp.news.cache.v1";
  const CACHE_TTL_MS = 15 * 60 * 1000;
  const QUERIES = ["generative AI", "LLM agents"];

  function timeAgo(iso: number): string {
    const mins = Math.max(1, Math.round((Date.now() - iso * 1000) / 60000));
    if (mins < 60) return `${mins}m ago`;
    const hours = Math.round(mins / 60);
    if (hours < 24) return `${hours}h ago`;
    return `${Math.round(hours / 24)}d ago`;
  }

  function domainOf(url: string | null): string {
    if (!url) return "news.ycombinator.com";
    try {
      return new URL(url).hostname.replace(/^www\./, "");
    } catch {
      return "news.ycombinator.com";
    }
  }

  function render(list: HTMLElement, hits: Hit[]) {
    if (!hits.length) {
      list.innerHTML = `<li class="pf-news__empty">No recent stories found.</li>`;
      return;
    }
    list.innerHTML = hits
      .map((h) => {
        const href = h.url ?? `https://news.ycombinator.com/item?id=${h.objectID}`;
        const title = h.title ?? "Untitled";
        return `<li class="pf-news__item">
          <a class="pf-news__title" href="${href}" target="_blank" rel="noopener noreferrer">${title}</a>
          <div class="pf-news__meta">
            <span>${domainOf(h.url)}</span>
            <span>${h.points ?? 0} pts</span>
            <span>${timeAgo(h.created_at)}</span>
          </div>
        </li>`;
      })
      .join("");
  }

  async function fetchNews(): Promise<Hit[]> {
    const results = await Promise.allSettled(
      QUERIES.map((q) =>
        fetch(
          `https://hn.algolia.com/api/v1/search_by_date?tags=story&query=${encodeURIComponent(q)}&hitsPerPage=8`,
        ).then((r) => {
          if (!r.ok) throw new Error(`HN API ${r.status}`);
          return r.json();
        }),
      ),
    );
    const hits = new Map<string, Hit>();
    for (const r of results) {
      if (r.status !== "fulfilled") continue;
      for (const h of r.value.hits as Hit[]) hits.set(h.objectID, h);
    }
    return [...hits.values()].sort((a, b) => b.created_at - a.created_at).slice(0, 6);
  }

  async function init() {
    const root = document.querySelector<HTMLElement>("[data-pf-news]");
    const list = root?.querySelector<HTMLElement>("[data-pf-news-list]");
    if (!root || !list) return;

    try {
      const cached = sessionStorage.getItem(CACHE_KEY);
      if (cached) {
        const { at, hits } = JSON.parse(cached);
        if (Date.now() - at < CACHE_TTL_MS) {
          render(list, hits);
          return;
        }
      }
    } catch {
      // Corrupt/blocked storage — fall through to a live fetch.
    }

    try {
      const hits = await fetchNews();
      render(list, hits);
      try {
        sessionStorage.setItem(CACHE_KEY, JSON.stringify({ at: Date.now(), hits }));
      } catch {
        // Storage full or blocked — the widget still rendered, just won't cache.
      }
    } catch {
      list.innerHTML = `<li class="pf-news__empty">Couldn't load latest stories right now.</li>`;
    }
  }

  init();
</script>
