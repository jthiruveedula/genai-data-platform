---
/**
 * Modernist shell for every page except the homepage, which carries its own
 * chrome as part of the scroll story.
 *
 * Replaces BaseLayout's dark-first shell: no atmosphere layer, no glass, no
 * theme toggle (Modernist is one light ground), no custom cursor. The reading
 * progress rail stays — it is a 2px accent rule, which the system allows —
 * and is driven by scroll position directly rather than through a GSAP
 * timeline, so there is no reveal animation to catch content mid-fade.
 */
import "@fontsource/archivo/400.css";
import "@fontsource/archivo/500.css";
import "@fontsource/archivo/600.css";
import "@fontsource/archivo/700.css";
import "@fontsource/archivo/800.css";
import "@fontsource/jetbrains-mono/400.css";
import archivo400 from "@fontsource/archivo/files/archivo-latin-400-normal.woff2?url";
import archivo800 from "@fontsource/archivo/files/archivo-latin-800-normal.woff2?url";
import "../styles/tokens/base.css";
import "../styles/tokens/component.css";
import "../styles/tokens/transitions.css";
import "../styles/modernist.css";
import "../styles/modernist-bridge.css";
import "../styles/site.css";
import { ClientRouter } from "astro:transitions";
import SiteNav from "../components/SiteNav.astro";
import SiteFooter from "../components/SiteFooter.astro";
import { loadClaims, claimStatus } from "../lib/claims";

interface Props {
  title: string;
  description?: string;
  /** Set on utility pages (404) that have no canonical URL of their own. */
  noIndex?: boolean;
}

const {
  title,
  description = "Design, build, integrate, and operate enterprise GenAI agent systems on GCP, AWS, Azure, or OSS.",
  noIndex = false,
} = Astro.props;

const claims = loadClaims();
const verifiedClaimCount = claims.filter((c) => claimStatus(c) === "verified").length;
---

<!doctype html>
<html lang="en" data-pf-cloud="gcp">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    {
      noIndex ? (
        <meta name="robots" content="noindex" />
      ) : (
        <>
          <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
          <meta property="og:type" content="website" />
          <meta property="og:site_name" content="GenAI Data Platform" />
          <meta property="og:title" content={`${title} · GenAI Data Platform`} />
          <meta property="og:description" content={description} />
          <meta property="og:url" content={new URL(Astro.url.pathname, Astro.site)} />
          <meta name="twitter:card" content="summary" />
          <meta name="twitter:title" content={`${title} · GenAI Data Platform`} />
          <meta name="twitter:description" content={description} />
        </>
      )
    }
    <link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL}favicon.svg`} />
    <link rel="preload" href={archivo400} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={archivo800} as="font" type="font/woff2" crossorigin />
    <ClientRouter />
    <title>{title} · GenAI Data Platform</title>
    <script is:inline>
      // Runs before paint so the cloud's accent and its per-flavor content are
      // right on the first frame. One selection, two attributes: `data-cloud`
      // for the content, `data-pf-cloud` for the accent token.
      (function () {
        var root = document.documentElement;
        var params = new URLSearchParams(location.search);
        var cloud = params.get("cloud") || localStorage.getItem("gdp.cloud") || "gcp";
        root.setAttribute("data-cloud", cloud);
        root.setAttribute("data-pf-cloud", cloud);
      })();
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <div class="reading-progress" role="progressbar" aria-hidden="true" aria-label="Reading progress">
      <div class="reading-progress__bar" data-reading-progress-bar></div>
    </div>
    <SiteNav />
    <main id="main" data-pagefind-body>
      <slot />
    </main>
    <SiteFooter verifiedClaimCount={verifiedClaimCount} totalClaimCount={claims.length} />
    <script>
      // Reading progress, read straight off scroll geometry in one rAF-throttled
      // handler. No timeline, no reveal: nothing on the page animates its own
      // opacity, so there is no mid-transition state for a contrast audit — or
      // a reader — to land on.
      function setupProgress() {
        const bar = document.querySelector<HTMLElement>("[data-reading-progress-bar]");
        if (!bar) return;
        const article = document.querySelector<HTMLElement>("article, main");
        if (!article) return;

        let queued = false;
        const paint = () => {
          queued = false;
          const start = article.offsetTop;
          const span = article.offsetHeight - window.innerHeight;
          const p = span <= 0 ? 0 : Math.max(0, Math.min(1, (window.scrollY - start) / span));
          bar.style.transform = `scaleX(${p})`;
        };
        const onScroll = () => {
          if (queued) return;
          queued = true;
          requestAnimationFrame(paint);
        };

        window.removeEventListener("scroll", onScroll);
        window.addEventListener("scroll", onScroll, { passive: true });
        paint();
      }

      setupProgress();
      document.addEventListener("astro:page-load", setupProgress);
    </script>
  </body>
</html>
